# ============================================================================
# ============================================================================
# ICsprout55 Magic technology file  (magic-vlsi 8.3.x, format 27)
# ============================================================================
# Clean-room technology for the ICsprout55 55nm LLULP 1P6M1TM process
# (1.2V core + 3.3V IO).  Scope: LVS netlist extraction and interconnect RC
# extraction via `extract all` + `ext2spice` (connectivity, MOS devices,
# sheet resistance, area/perimeter capacitance, via resistance).
#
# The `connect` section qualifies every contact by the layers it touches
# (`ct/a`, `ct/m1`, `v1/a`, ...) so that a contact only joins the two planes
# it really sits between.  Without that, Magic merges all contacts at one
# coordinate and fragments poly/diffusion nets (see the LVS section of the
# README).  `stackable` in the contact section is required for a contact and
# a via drawn at exactly the same centre (CT + V1).  The tap rules connect an
# n+ tap to nwell and make a p+ tap part of the substrate node, so physical
# taps in a macro are extracted as real body connections.
#
# Provenance of the extraction values (all from released PDK data):
#   sheet resistance  RPERSQ                  - N551P6M.lef
#   area capacitance  CAPACITANCE CPERSQDIST  - N551P6M_ecos.lef
#   edge capacitance  EDGECAPACITANCE         - N551P6M_ecos.lef
#   via resistance    VIA RESISTANCE          - N551P6M.lef (2.5 ohm, all levels)
#   MOS device names  official CDL models     - H7CR svt / H7CL lvt / H7CH hvt
#                                              / IO nm3p3_lp+pm3p3_lp
# NOT released (placeholders, marked): poly/diff sheet resistance, gate-oxide
# capacitance (Cox), layer-to-layer overlap and lateral coupling capacitance.
# DRC is intentionally DUMMY - the ICsprout55 DRC runs in KLayout only.
#
# Usage:
#   magic -T libs.tech/magic/ics55.tech -dnull -noconsole -rcfile /dev/null
#   gds read <file.gds> ; cellname <top> ; extract all ; ext2spice
# ============================================================================

tech
	format 35
	ics55
end

version
	version 0.1
	description "ICsprout55 55nm LLULP 1P6M1TM (1.2V/3.3V), clean-room LEF-seed RC extraction"
end

# ---------------------------------------------------------------------------
# Planes: the extraction order defines the capacitance reference ("substrate").
# ---------------------------------------------------------------------------
planes
	well,w
	# Derived diode junction regions live on their own plane so that contact
	# cuts on the active plane cannot split the device region.
	diodeactive,da
	active,a
	metal1,m1
	metal2,m2
	metal3,m3
	metal4,m4
	metal5,m5
	topm2,tm2
end

# ---------------------------------------------------------------------------
# Tile types.  ndiff/pdiff are the ACT under NP/PP (compose below); poly and
# diff share the active plane (transistor regions).  Contacts (ct, v1..tv2)
# appear on both the planes they bridge.
# ---------------------------------------------------------------------------
types
	well	nwell,nw
	well	pwell
	active	act
	active	ndiffusion,ndiff,nd
	active	pdiffusion,pdiff,pd
	active	polysilicon,poly,p
	active	np
	active	pp
	active	nvt1
	active	pvt1
	active	nvt3
	active	pvt3
	active	tgox
	active	lvtndiff
	active	lvtpdiff
	active	hvtndiff
	active	hvtpdiff
	active	iondiff
	active	iopdiff
	active	nfet
	active	pfet
	active	lvtnfet
	active	lvtpfet
	active	hvtnfet
	active	hvtpfet
	active	ionfet
	active	iopfet
	active	diode
	diodeactive	pdio1p2lvt
	diodeactive	ndio1p2lvt
	diodeactive	pdio3p3
	# Poly resistor body (POLYres 41/4 covers the SAB-defined resistor).
	active	rppo
	active	sab
	active	polyres
	active	ncontact,ct
	metal1	metal1,m1
	metal1	m2contact,v1
	metal2	metal2,m2
	metal2	m3contact,v2
	metal3	metal3,m3
	metal3	m4contact,v3
	metal4	metal4,m4
	metal4	m5contact,v4
	metal5	metal5,m5
	metal5	tm2contact,tv2
	topm2	topmetal2,tm2
end


# ---------------------------------------------------------------------------
# Contacts / vias
# ---------------------------------------------------------------------------
contact
	ct	ndiff	m1
	ct	pdiff	m1
	# Threshold / IO variants of the diffusion are composed types, so each
	# needs its own contact rule (the CDL model split depends on it).
	ct	lvtndiff	m1
	ct	lvtpdiff	m1
	ct	hvtndiff	m1
	ct	hvtpdiff	m1
	ct	iondiff		m1
	ct	iopdiff		m1
	ct	poly	m1
	v1	m1	m2
	v2	m2	m3
	v3	m3	m4
	v4	m4	m5
	tv2	m5	tm2

	# A contact and a via drawn at exactly the same centre must stack
	# (a coincident CT + V1 otherwise loses the lower contact).
	stackable
end
# ---------------------------------------------------------------------------
# Composition: the diff types are the ACT under the implants; the transistors
# are poly over diff.
# ---------------------------------------------------------------------------
compose
	compose	ndiff	act	np
	compose	pdiff	act	pp
	# threshold / IO variants (official CDL model split):
	#   H7CR -> nm1p2_svt_lp / pm1p2_svt_lp  (plain ndiff/pdiff)
	#   H7CL -> nm1p2_lvt_lp / pm1p2_lvt_lp  (NVT1/PVT1, 17/1, 18/1)
	#   H7CH -> nm1p2_hvt_lp / pm1p2_hvt_lp  (NVT3/PVT3, 21/1, 22/1)
	#   IO   -> nm3p3_lp / pm3p3_lp          (ACT under TGOX 28/1)
	compose	lvtndiff	ndiff	nvt1
	compose	lvtpdiff	pdiff	pvt1
	compose	hvtndiff	ndiff	nvt3
	compose	hvtpdiff	pdiff	pvt3
	compose	iondiff	ndiff	tgox
	compose	iopdiff	pdiff	tgox
	compose	nfet	poly	ndiff
	compose	pfet	poly	pdiff
	compose	lvtnfet	poly	lvtndiff
	compose	lvtpfet	poly	lvtpdiff
	compose	hvtnfet	poly	hvtndiff
	compose	hvtpfet	poly	hvtpdiff
	compose	ionfet	poly	iondiff
	compose	iopfet	poly	iopdiff
end
# ---------------------------------------------------------------------------
# Connectivity for extraction (same-plane nets; the contact section handles
# the via connections).  The p-substrate is the space on the well plane.
# ---------------------------------------------------------------------------
connect
	# An n+ tap is the nwell contact; a p+ tap is a substrate contact
	# (the `substrate` rule below puts pdiff in the substrate node).
	nwell,ndiff,lvtndiff,hvtndiff,iondiff	nwell,ndiff,lvtndiff,hvtndiff,iondiff
	ndiff,ct/a	ndiff,ct/a
	pdiff,ct/a	pdiff,ct/a
	lvtndiff,ct/a	lvtndiff,ct/a
	lvtpdiff,ct/a	lvtpdiff,ct/a
	hvtndiff,ct/a	hvtndiff,ct/a
	hvtpdiff,ct/a	hvtpdiff,ct/a
	iondiff,ct/a	iondiff,ct/a
	iopdiff,ct/a	iopdiff,ct/a
	# The junction region sits on the diodeactive plane above the diffusion
	# it was derived from; these rules make it the same node as that
	# diffusion and its contact image (metal1 is reached through the
	# ordinary ct/pdiff rule).
	pdio1p2lvt,pdiff,ct/a	pdio1p2lvt,pdiff,ct/a
	ndio1p2lvt,ndiff,ct/a	ndio1p2lvt,ndiff,ct/a
	pdio3p3,pdiff,ct/a	pdio3p3,pdiff,ct/a
	poly,nfet,pfet,lvtnfet,lvtpfet,hvtnfet,hvtpfet,ionfet,iopfet,ct/a	poly,nfet,pfet,lvtnfet,lvtpfet,hvtnfet,hvtpfet,ionfet,iopfet,ct/a
	m1,ct/m1,v1/a,v1/m1	m1,ct/m1,v1/a,v1/m1
	m2,v1/a,v1/m2,v2/a,v2/m2	m2,v1/a,v1/m2,v2/a,v2/m2
	m3,v2/a,v2/m3,v3/a,v3/m3	m3,v2/a,v2/m3,v3/a,v3/m3
	m4,v3/a,v3/m4,v4/a,v4/m4	m4,v3/a,v3/m4,v4/a,v4/m4
	m5,v4/a,v4/m5,tv2/a,tv2/m5	m5,v4/a,v4/m5,tv2/a,tv2/m5
	tm2,tv2/a,tv2/tm2	tm2,tv2/a,tv2/tm2
end


# ---------------------------------------------------------------------------
# Extraction: Magic takes area capacitance in aF/lambda^2 and perimeter
# capacitance in aF/lambda (tech file manual, "extract" section), NOT per
# micron.  The released LEF publishes fF/um^2 and fF/um; the values below are
# those numbers converted for the 5 nm layout grid this PDK is drawn on
# (1 um^2 = 40000 lambda^2, 1 um = 200 lambda).  Dividing the LEF numbers by
# those factors is what makes the extracted C match the geometry: a 0.07 um^2
# VSS rail now extracts as 53 aF instead of 0.87 pF.
# Resistance values stay in mOhm/square and mOhm/via, which Magic already
# expects.  The coupling model is intentionally absent (not released).
# ---------------------------------------------------------------------------
extract
	style	ngspice()
	lambda 1E6
	units	microns
	step	1
	sidehalo	0.2
	planeorder	well	0
	planeorder	diodeactive	1
	planeorder	active	2
	planeorder	metal1	3
	planeorder	metal2	4
	planeorder	metal3	5
	planeorder	metal4	6
	planeorder	metal5	7
	planeorder	topm2	8

	# p-substrate = the pwell regions and the areas of the well plane where
	# no nwell is drawn
	substrate	pdiff,lvtpdiff,hvtpdiff,iopdiff,pwell,space/w	w	$SUB

	# --- sheet resistance (mOhm/sq), N551P6M.lef RPERSQ ---
	# poly: sheet resistance NOT released - ideal conductor placeholder (0)
	resist	poly	0
	# Silicide-blocked p+ poly resistor; Calibre rsh_rpposab = 725.7 ohm/sq.
	resist	rppo	725700
	resist	m1	112
	resist	m2	91
	resist	m3	91
	resist	m4	91
	resist	m5	91
	resist	tm2	24

	# --- via resistance (mOhm per via), N551P6M.lef VIA RESISTANCE ---
	resist	v1	2500
	resist	v2	2500
	resist	v3	2500
	resist	v4	2500
	resist	tv2	2500

	# --- area capacitance to substrate/plane below (aF/lambda^2) ---
	# lambda here is the 10 nm database grid, so 1 um^2 = 10000 lambda^2.
	# A stored value v is v * 1e4 aF/um^2 = v * 0.01 fF/um^2.  The LEF
	# CPERSQDIST value (pF/um^2) x 0.1 therefore gives v directly, e.g.
	# M1: 0.000763 pF/um^2 -> 0.0763 -> 763 aF/um^2.
	# poly: gate-oxide capacitance NOT released - placeholder (0)
	areacap	poly	0
	areacap	m1	0.0763
	areacap	m2	0.11069
	areacap	m3	0.11069
	areacap	m4	0.11069
	areacap	m5	0.06259
	areacap	tm2	0.01299
	# --- perimeter (fringe) capacitance (aF/lambda) ---
	# A stored value v is v * 100 aF/um, i.e. the LEF EDGECAPACITANCE
	# (pF/um) x 10, e.g. M1: 0.0000339 pF/um -> 0.339 -> 33.9 aF/um.
	perimc	m1	space	0.339
	perimc	m2	space	0.391
	perimc	m3	space	0.409
	perimc	m4	space	0.409
	perimc	m5	space	0.344
	perimc	tm2	space	0.368
	# --- MOS devices (official CDL model names; Cox/overlap NOT released) ---
	# The last two fields (gate cap aF/um^2, overlap aF/um) are placeholders 0:
	# the gate-oxide capacitance is not in the released data.  The extracted
	# netlist device names match the official CDL models, so ext2spice output
	# can be diffed against the CDL.
	# device mosfet <model> <device-types> <sd-types> <well>
	# (gate cap / overlap not released -> no cap terms)
	device mosfet	nm1p2_svt_lp	nfet	ndiff,ct	pwell,space/w
	device mosfet	pm1p2_svt_lp	pfet	pdiff,ct	nwell
	device mosfet	nm1p2_lvt_lp	lvtnfet	lvtndiff,ct	pwell,space/w
	device mosfet	pm1p2_lvt_lp	lvtpfet	lvtpdiff,ct	nwell
	device mosfet	nm1p2_hvt_lp	hvtnfet	hvtndiff,ct	pwell,space/w
	device mosfet	pm1p2_hvt_lp	hvtpfet	hvtpdiff,ct	nwell
	device mosfet	nm3p3_lp	ionfet	iondiff,ct	pwell,space/w
	device mosfet	pm3p3_lp	iopfet	iopdiff,ct	nwell

	# --- diodes ---------------------------------------------------------
	# device pdiode/ndiode <model> <device-types> <negative-types> [params]
	# The device region is the derived junction on the diodeactive plane,
	# so contact cuts do not split it.  `a` is the junction area and `pj`
	# its perimeter, both in um^2 / um.
	device pdiode	dio_1p2_pp_nw_lvt_lp	pdio1p2lvt	nwell	a=area	p=pj
	device ndiode	dio_1p2_np_pw_lvt_lp	ndio1p2lvt	pwell,space/w	a=area	p=pj
	device pdiode	dio_3p3_pp_nw_lp	pdio3p3	nwell	a=area	p=pj

	# Each straight poly segment extracts as one resistor; netgen combines
	# the folded series segments into the CDL's single W/L (see run_lvs.py).
	device rsubcircuit	re_ppo_sab_2t	rppo	poly	l=l	w=w
end

# ---------------------------------------------------------------------------
# DRC: intentionally DUMMY.  The real ICsprout55 DRC is done in KLayout
# (libs.tech/drc/ics55_drc.drc).  One harmless width rule keeps the section
# non-empty so the tech file loads cleanly.
# ---------------------------------------------------------------------------
drc
	style	lambda=0.001(ics55)
	width	m1	0.09	dummy
end

# ---------------------------------------------------------------------------
# Display styles (minimal; colors are nominal, not foundry-defined)
# ---------------------------------------------------------------------------
styles
	styletype	mos

	nwell		1
	act		2
	ndiff		3
	pdiff		4
	poly		5
	np		6
	pp		7
	nvt1		8
	pvt1		9
	nvt3		10
	pvt3		11
	tgox		12
	lvtndiff	13
	lvtpdiff	14
	hvtndiff	15
	hvtpdiff	16
	iondiff		17
	iopdiff		18
	nfet		19
	pfet		20
	lvtnfet		21
	lvtpfet		22
	hvtnfet		23
	hvtpfet		24
	ionfet		25
	iopfet		26
	ct		27
	m1		28
	m2		29
	m3		30
	m4		31
	m5		32
	tm2		33
	v1		34
	v2		35
	v3		36
	v4		37
	tv2		38
end

# ---------------------------------------------------------------------------
# LEF layer-name mapping (needed by the Magic LEF/DEF readers in the
# LibreLane stream-out flow).  layer <LEF-name> <magic-type>
# ---------------------------------------------------------------------------
lef
    routing m1  MET1 m1
    routing m2  MET2 m2
    routing m3  MET3 m3
    routing m4  MET4 m4
    routing m5  MET5 m5
    routing tm2 T4M2 tm2
    cut v1  VIA1 v1
    cut v2  VIA2 v2
    cut v3  VIA3 v3
    cut v4  VIA4 v4
    cut tv2 T4V2 tv2
end

# ---------------------------------------------------------------------------
# CIF/GDS input mapping.  layer <magic-types> <cifname> [+/- booleans]
# ---------------------------------------------------------------------------
cifinput
	style	lambda=0.001(ics55)
	scalefactor	1
	# Unknown-layer labels are junked rather than moved onto an
	# unrelated plane; administrative markers live on layers above 255
	# and therefore land here.
	options	ignore-unknown-layer-labels

	# --- non-electrical input layers -------------------------------------
	# Markers, dummy fill and unmodelled conductors.  A cifinput
	# `templayer` is never painted, so it cannot create connectivity.
	# SAB (71/1) and PPO (41/4) are real `layer`s because a templayer's
	# plane is not visible to a later `layer` boolean; the resistor body
	# `rppo` is derived from those planes below.
	# DIODE is the exception: `templayer` planes are discarded before the
	# layer list is evaluated and cannot be used as an `and` operand, so
	# it is painted as the inert `diode` type, first, so that act/np/pp
	# override the marker tile and transistor composition is unaffected.
	# GDS layer numbers above 255 (CALMA_LAYER_MAX) cannot be mapped at
	# all; 261/12, 313/12, 351/12, 354/12, 356/12 and 357/12 therefore
	# stay unreadable and `gds read` keeps reporting them.
	layer	diode	DIODE
		calma	DIODE	191	12
	ignore	DIODE
	# PPO (41/4) is the Calibre POLYres marker; SAB (71/1) is silicide block.
	# Both must be real layers so the `rppo` boolean can see their planes.
	layer	polyres	PPO
		calma	PPO	41	4
	templayer	ESD
		calma	ESD	55	1
	ignore	ESD
	layer	sab	SAB
		calma	SAB	71	1
	ignore	SAB
	templayer	MET1DUM
		calma	MET1DUM	81	2
	ignore	MET1DUM
	templayer	RV
		calma	RV	120	1
	ignore	RV
	templayer	CB
		calma	CB	121	1
	ignore	CB
	templayer	RDL
		calma	RDL	123	1
	ignore	RDL
	templayer	RDLLBL
		calma	RDLLBL	123	6
	ignore	RDLLBL

	# --- electrical layers ------------------------------------------------
	# Metal label datatypes (81/6, 82/6, ...) are read with the conductor
	# so that a pin label attaches to the metal under it.
	layer	act		CAA
		calma	CAA	2	1
	layer	nwell		CNW
		calma	CNW	9	1
	layer	np		CNP
		calma	CNP	52	1
	layer	pp		CPP
		calma	CPP	53	1
	layer	nvt1		CNVT1
		calma	CNVT1	17	1
	layer	pvt1		CPVT1
		calma	CPVT1	18	1
	layer	nvt3		CNVT3
		calma	CNVT3	21	1
	layer	pvt3		CPVT3
		calma	CPVT3	22	1
	layer	tgox		CTG
		calma	CTG	28	1
	layer	poly		CPG
		calma	CPG	41	1

	# --- derived diode junction types ------------------------------------
	# <type> := ACT & PP/NP & DIODE & threshold, minus POLY.  This is the
	# Calibre deck's pDioJunc/nDioJunc plus the threshold selector
	# (pdiocore_lvt_diode = ((pJunc - ACTres) & DIODE - PSUB) & PVT1).
	# A cifinput layer only sees read layers defined above it, so this
	# must come after act/pp/np/nwell/pvt1/diode/poly; it must also come
	# *before* `ct`, because painting the derived type replaces the
	# diffusion tile - a later paint would erase the contact composition.
	#
	# Syntax: `layer <type> <spec>` takes at most 3 fields, so every
	# boolean must be its own continuation line (`and`, `and-not`, `or`).
	# An inline "layer X A and B ..." is rejected (too many arguments) and
	# leaves a layer with no geometry.
	layer	pdio1p2lvt	CAA
		and	CPP
		and	CNW
		and	DIODE
		and	CPVT1
		and-not	CTG
		and-not	CPG
	layer	ndio1p2lvt	CAA
		and	CNP
		and	CNVT1
		and	DIODE
		and-not	CNW
		and-not	CTG
		and-not	CPG
	layer	pdio3p3	CAA
		and	CPP
		and	CNW
		and	CTG
		and	DIODE
		and-not	CPVT1
		and-not	CPVT3
		and-not	CPG
	# Silicide-blocked p+ poly resistor body: the Calibre deck's
	# rpposab_2T = ((resPOLY & PP) & SAB) - RES3TPOLY - HRP.
	layer	rppo	CPG
		and	CPP
		and	SAB
		and	PPO
	layer	ct		CCT
		calma	CCT	72	1

	layer	m1		CM1,M1LBL
		calma	CM1	81	1
		calma	M1LBL	81	6
		labels	M1LBL
	layer	m2		CM2,M2LBL
		calma	CM2	82	1
		calma	M2LBL	82	6
		labels	M2LBL
	layer	m3		CM3,M3LBL
		calma	CM3	83	1
		calma	M3LBL	83	6
		labels	M3LBL
	layer	m4		CM4,M4LBL
		calma	CM4	84	1
		calma	M4LBL	84	6
		labels	M4LBL
	layer	m5		CM5,M5LBL
		calma	CM5	85	1
		calma	M5LBL	85	6
		labels	M5LBL
	layer	tm2		CTM,T4M2LBL
		calma	CTM	103	1
		calma	T4M2LBL	103	6
		labels	T4M2LBL
	layer	v1		CV1
		calma	CV1	91	1
	layer	v2		CV2
		calma	CV2	92	1
	layer	v3		CV3
		calma	CV3	93	1
	layer	v4		CV4
		calma	CV4	94	1
	layer	tv2		CTV
		calma	CTV	113	1
end

# ---------------------------------------------------------------------------
# CIF/GDS output mapping.  layer <cifname> <magic-types> gds <num> <type>
# scalefactor 1 = 1 DBU = 1 nm.
# ---------------------------------------------------------------------------
cifoutput
	style	lambda=0.001(ics55)
	scalefactor	1

	layer	CAA	ndiff,pdiff
		gds	2	1
	layer	CNW	nwell
		gds	9	1
	layer	CPG	poly
		gds	41	1
	layer	CCT	ct
		gds	72	1
	layer	CM1	m1
		gds	81	1
	layer	CM2	m2
		gds	82	1
	layer	CM3	m3
		gds	83	1
	layer	CM4	m4
		gds	84	1
	layer	CM5	m5
		gds	85	1
	layer	CTM	tm2
		gds	103	1
	layer	CV1	v1
		gds	91	1
	layer	CV2	v2
		gds	92	1
	layer	CV3	v3
		gds	93	1
	layer	CV4	v4
		gds	94	1
	layer	CTV	tv2
		gds	113	1
end

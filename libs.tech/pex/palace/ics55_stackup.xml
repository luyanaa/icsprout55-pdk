<!-- ============================================================================
  ICsprout55 55nm LLULP 1P6M1TM gds2palace stackup (schemaVersion 2.0, legacy)
  ============================================================================
  Clean-room estimates for the AWS Palace / gds2palace FEM workflow.  The
  released PDK data (N551P6M.lef) carries no absolute thicknesses and no
  dielectric permittivities; the values below are estimates chosen with the
  user (2026-09-25):

    metal thickness   t = rho_bulk / Rsh   (rho_bulk = 1.72e-8 ohm*m, bulk Cu)
                       -> all metals land at sigma ~= 5.81e7 S/m (bulk Cu),
                       consistent with the LEF RPERSQ by construction.
    via conductivity  sigma = h / (R_via * w^2)  (R_via = 2.5 ohm from LEF,
                       w = LEF via cut size, h = via height)
    dielectrics       eps_r 3.3 (low-k IMD), 3.9 (PMD), 4.0 (passivation),
                       11.9 (Si substrate, sigma 10 S/m ~ 10 ohm*cm);
                       typical 55nm-node vertical metal spacing 0.12 um,
                       PMD 0.15 um, passivation 0.5 um above the top metal,
                       substrate 200 um.

  Coordinate convention (verified against gds2palace 0.6.0):
    z = 0 at the substrate bottom; the dielectrics in the file are ordered
    top-first and the reader stacks them bottom-up; every metal/via zmin must
    land inside its intended dielectric's z-range (the metal is then embedded
    in that dielectric).  The dielectric ranges below therefore span
    metal-bottom to next-metal-bottom (metal heights are inside the ranges).
    The GDS layer numbers follow the official layer map
    (libs.tech/klayout/tech/ics55.map).  All values are overridable here.
  ============================================================================ -->
<Stackup schemaVersion="2.0">
  <Materials>
    <Material Name="Metal1"  Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="39bfff" />
    <Material Name="Metal2"  Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="ccccd9" />
    <Material Name="Metal3"  Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="d80000" />
    <Material Name="Metal4"  Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="93e837" />
    <Material Name="Metal5"  Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="dcd146" />
    <Material Name="TopMetal" Type="Conductor" Conductivity="58139534.9" ThermalConductivity="385.0" Density="8960.0" Color="ff8000" />
    <Material Name="Via1"    Type="Conductor" Conductivity="5925926.0" ThermalConductivity="385.0" Density="8960.0"  Color="ccccff" />
    <Material Name="Via2"    Type="Conductor" Conductivity="5925926.0" ThermalConductivity="385.0" Density="8960.0"  Color="ff3736" />
    <Material Name="Via3"    Type="Conductor" Conductivity="5925926.0" ThermalConductivity="385.0" Density="8960.0"  Color="9ba940" />
    <Material Name="Via4"    Type="Conductor" Conductivity="5925926.0" ThermalConductivity="385.0" Density="8960.0"  Color="deac5e" />
    <Material Name="TopVia"  Type="Conductor" Conductivity="370370.0" ThermalConductivity="385.0" Density="8960.0"   Color="ffe6bf" />
    <Material Name="IMD"     Type="Dielectric" Permittivity="3.3" ThermalConductivity="0.6" Density="2200.0" DielectricLossTangent="0.01" Color="fffcad" />
    <Material Name="PMD"     Type="Dielectric" Permittivity="3.9" ThermalConductivity="1.4" Density="2200.0" DielectricLossTangent="0.01" Color="fffcad" />
    <Material Name="Passivation" Type="Dielectric" Permittivity="4.0" ThermalConductivity="1.5" Density="2500.0" DielectricLossTangent="0.01" Color="a0a0f0" />
    <Material Name="Substrate" Type="Semiconductor" Permittivity="11.9" DielectricLossTangent="0.0" Conductivity="10.0" ThermalConductivity="150.0" Density="2329.0" Color="01e0ff" />
    <Material Name="AIR"     Type="Dielectric" Permittivity="1.0" ThermalConductivity="0.026" Density="1.0" DielectricLossTangent="0.0" Color="d0d0d0" />
  </Materials>
  <ELayers LengthUnit="um">
    <Dielectrics>
      <!-- ordered top-first; the reader stacks them bottom-up.  Each range
           spans metal-bottom to next-metal-bottom (metals are embedded). -->
      <Dielectric Name="Passivation" Material="Passivation" Thickness="1.2197" />
      <Dielectric Name="IMD5"  Material="IMD" Thickness="0.3090" />
      <Dielectric Name="IMD4"  Material="IMD" Thickness="0.3082" />
      <Dielectric Name="IMD3"  Material="IMD" Thickness="0.3082" />
      <Dielectric Name="IMD2"  Material="IMD" Thickness="0.3082" />
      <Dielectric Name="IMD1"  Material="IMD" Thickness="0.2733" />
      <Dielectric Name="PMD"   Material="PMD" Thickness="0.1500" />
      <Dielectric Name="Substrate" Material="Substrate" Thickness="200.0000" />
    </Dielectrics>
    <Layers>
      <!-- absolute Zmin/Zmax (um); z=0 at the substrate bottom -->
      <Layer Name="TM2"  Type="conductor" Zmin="201.6569" Zmax="202.3766" Material="TopMetal" Layer="103" />
      <Layer Name="M5"   Type="conductor" Zmin="201.3479" Zmax="201.5361" Material="Metal5"   Layer="85" />
      <Layer Name="M4"   Type="conductor" Zmin="201.0397" Zmax="201.2279" Material="Metal4"   Layer="84" />
      <Layer Name="M3"   Type="conductor" Zmin="200.7315" Zmax="200.9197" Material="Metal3"   Layer="83" />
      <Layer Name="M2"   Type="conductor" Zmin="200.4233" Zmax="200.6115" Material="Metal2"   Layer="82" />
      <Layer Name="M1"   Type="conductor" Zmin="200.1500" Zmax="200.3033" Material="Metal1"   Layer="81" />
      <Layer Name="TV2"  Type="via"      Zmin="201.5361" Zmax="201.6569" Material="TopVia"   Layer="113" />
      <Layer Name="V4"   Type="via"      Zmin="201.2279" Zmax="201.3479" Material="Via4"     Layer="94" />
      <Layer Name="V3"   Type="via"      Zmin="200.9197" Zmax="201.0397" Material="Via3"     Layer="93" />
      <Layer Name="V2"   Type="via"      Zmin="200.6115" Zmax="200.7315" Material="Via2"     Layer="92" />
      <Layer Name="V1"   Type="via"      Zmin="200.3033" Zmax="200.4233" Material="Via1"     Layer="91" />
    </Layers>
  </ELayers>
</Stackup>

* ---------------------------------------------------------------------------
* 5T/6T triple-well flavours. The core is the matching 4T subcircuit; only
* the well/substrate junction network is added. pw_dnw_enc / dnw_psub_enc
* are the active-to-DNW and DNW-to-PSUB enclosure estimates used to size the
* reverse-biased junctions.
* ---------------------------------------------------------------------------

.subckt ics55_rf_nmos_svt_5t D G S B DNW wf=2u l=60n nf=4
+ sa=0.24u sb=0.24u sd=0.30u mismod=0
+ rg_feed=1u rd_feed=1u rs_feed=1u rb_feed=1u
+ cgd_feed=0 cgs_feed=0 cds_feed=0
+ rwell=1k pw_dnw_enc=0.5u
.param apw='(wf*nf+2*pw_dnw_enc)*(l+2*pw_dnw_enc)'
.param ppw='2*((wf*nf+2*pw_dnw_enc)+(l+2*pw_dnw_enc))'
Xm D G S B ics55_rf_nmos_svt_4t wf={wf} l={l} nf={nf}
+ sa={sa} sb={sb} sd={sd} mismod={mismod}
+ rg_feed={rg_feed} rd_feed={rd_feed} rs_feed={rs_feed} rb_feed={rb_feed}
+ cgd_feed={cgd_feed} cgs_feed={cgs_feed} cds_feed={cds_feed}
Rwell B DNW {rwell}
Dbd B DNW dio_1p2_pw_dnw_lp AREA={apw} PJ={ppw}
.ends ics55_rf_nmos_svt_5t

.subckt ics55_rf_nmos_lvt_5t D G S B DNW wf=2u l=60n nf=4
+ sa=0.24u sb=0.24u sd=0.30u mismod=0
+ rg_feed=1u rd_feed=1u rs_feed=1u rb_feed=1u
+ cgd_feed=0 cgs_feed=0 cds_feed=0
+ rwell=1k pw_dnw_enc=0.5u
.param apw='(wf*nf+2*pw_dnw_enc)*(l+2*pw_dnw_enc)'
.param ppw='2*((wf*nf+2*pw_dnw_enc)+(l+2*pw_dnw_enc))'
Xm D G S B ics55_rf_nmos_lvt_4t wf={wf} l={l} nf={nf}
+ sa={sa} sb={sb} sd={sd} mismod={mismod}
+ rg_feed={rg_feed} rd_feed={rd_feed} rs_feed={rs_feed} rb_feed={rb_feed}
+ cgd_feed={cgd_feed} cgs_feed={cgs_feed} cds_feed={cds_feed}
Rwell B DNW {rwell}
Dbd B DNW dio_1p2_pw_dnw_lp AREA={apw} PJ={ppw}
.ends ics55_rf_nmos_lvt_5t


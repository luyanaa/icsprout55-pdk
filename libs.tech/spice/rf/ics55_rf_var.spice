.param jperi='2*((wr+2*waddr)+(lr*nf+(nf-1)*0.2u+0.35u+2*laddr))'
.param cox_port='cox_areacap*wr*lr*nf'
Ls 1 12 '{ls_per_m*lr}'
Rs 12 11 {rs_series}
Xcore 11 2 var1p2_npd_nw_lp lr={lr} wr={wr} nf={nf}
+ mismod_var={mismod_var} mr={mr}
Ddnw 2 0 dio_1p2_dnw_psub_lp AREA={jarea} PJ={jperi}
Cox1 11 21 {cox_port}
Rsub1 21 0 {rsub}
Csub1 21 0 '{csub_frac*cox_port}'
Cox2 2 22 {cox_port}
Rsub2 22 0 {rsub}
Csub2 22 0 '{csub_frac*cox_port}'
.ends var1p2_npd_nw_dnw_lp_rf

* 1.2 V RF varactor in DNW with explicit p-substrate terminal.
.subckt var1p2_npd_nw_dnw_lp_rf_3t 1 2 SUB lr=1u wr=1u nf=1
+ mismod_var=0 mr=1 laddr=2u waddr=2u
+ ls_per_m=0.6e-6 rs_series=0.5
+ cox_areacap=1e-3 csub_frac=0.3 rsub=500
.param jarea='(wr+2*waddr)*(lr*nf+(nf-1)*0.2u+0.35u+2*laddr)'
.param jperi='2*((wr+2*waddr)+(lr*nf+(nf-1)*0.2u+0.35u+2*laddr))'
.param cox_port='cox_areacap*wr*lr*nf'
Ls 1 12 '{ls_per_m*lr}'
Rs 12 11 {rs_series}
Xcore 11 2 var1p2_npd_nw_lp lr={lr} wr={wr} nf={nf}
+ mismod_var={mismod_var} mr={mr}
Ddnw 2 SUB dio_1p2_dnw_psub_lp AREA={jarea} PJ={jperi}
Cox1 11 21 {cox_port}
Rsub1 21 SUB {rsub}
Csub1 21 SUB '{csub_frac*cox_port}'
Cox2 2 22 {cox_port}
Rsub2 22 SUB {rsub}
Csub2 22 SUB '{csub_frac*cox_port}'

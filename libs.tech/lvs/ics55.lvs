#=========================================================================================
# ICsprout55 (ICS55) KLayout LVS runset - provisional
#
# Port of the iLVS device-recognition table (libs.tech/lvs/README.md) to the
# KLayout LVS engine, following the FreePDK45 well/implant device split
# (nact/pact, ngate/pgate, psd/nsd) and the IHP SG13G2 runset structure.
#
# Devices:
#   core MOS 1.2V : nm1p2_{svt,lvt,hvt}_lp / pm1p2_{svt,lvt,hvt}_lp
#   IO MOS 3.3V   : nm3p3_lp / pm3p3_lp (TGOX selectors)
#   resistors     : PPO/SAB poly, stack-selected M1-M5 or T4M1/T4M2, ALPAD
#   diode         : dio_3p3_pp_nw_lp (DIODE marker 191/12; TGOX junction)
#   MOM cap       : not extracted
#
# Bulk connectivity (std-cell convention, CDL bulk = VDD/VSS):
#   - p-substrate (layout extent minus NW) is globally tied to VSS;
#   - n-well is globally tied to VDD.
#   Both can be disabled with -rd no_well_ties=true for analog blocks with
#   isolated wells (bulk nets then float and must be resolved manually).
#
# Usage:
#   klayout -b -r ics55.lvs -rd input=<layout.gds> [-rd top=<topcell>] \
#       -rd schematic=<cell.cdl> [-rd target_netlist=<extracted.cir>] \
#       [-rd report=<out.lvsdb>] [-rd combine_devices=true] \
#       [-rd strict_topology=true [-rd strict_hierarchy=true]] [-z]
#
# Reference netlist lookup: if -rd schematic is omitted, the deck looks for
# <topcell>.cdl / .spice / .cir next to the input layout (IHP convention).
#=========================================================================================

require 'etc'

#-----------------------------------------------------------------------------------------
# File setup
#-----------------------------------------------------------------------------------------

if $input
  if $top
    src = source($input, $top)
  else
    src = source($input)
  end
end

if $report
  report_lvs($report)
else
  report_lvs("ics55_lvs.lvsdb")
end

#-----------------------------------------------------------------------------------------
# Switches
#-----------------------------------------------------------------------------------------

def bool_check?(obj)
  obj.to_s.downcase == 'true'
end

SPICE_WITH_NET_NAMES = !bool_check?($no_net_names)
SPICE_WITH_COMMENTS = bool_check?($spice_comments)
NET_ONLY = bool_check?($net_only)
STRICT_TOPOLOGY = bool_check?($strict_topology)
# Hierarchy is opt-in and valid only with the strict comparison contract.
STRICT_HIERARCHY = bool_check?($strict_hierarchy)
if STRICT_HIERARCHY && !STRICT_TOPOLOGY
  raise "strict_hierarchy requires strict_topology=true"
end
if STRICT_HIERARCHY && NET_ONLY
  raise "strict_hierarchy cannot be used with net_only=true"
end
if STRICT_HIERARCHY && $run_mode.to_s == 'flat'
  raise "strict_hierarchy requires deep physical extraction"
end
# Generated macros require the declared boundary, including unused pins.
# Physical-parallel combination is safe; simplify can remove that boundary.
COMBINE_DEVICES = STRICT_TOPOLOGY || bool_check?($combine_devices)
PURGE = !STRICT_TOPOLOGY && bool_check?($purge)
SIMPLIFY = !STRICT_TOPOLOGY && !bool_check?($no_simplify)
WELL_TIES = !bool_check?($no_well_ties)

# Strict-flat comparison must flatten physical extraction as well as source.
# Keep explicit modes and extraction-only/generic/hierarchical defaults intact.
run_mode = $run_mode
if run_mode.to_s.empty? && STRICT_TOPOLOGY && !STRICT_HIERARCHY && !NET_ONLY
  run_mode = 'flat'
end
case run_mode
when 'flat'
  flat
else
  deep
end

threads($threads || Etc.nprocessors)

require 'tmpdir'

#-----------------------------------------------------------------------------------------
# Schematic (reference) netlist
#-----------------------------------------------------------------------------------------

# The released CDL dumps repeat some leaf subckts (e.g. TG appears twice);
# KLayout's SPICE reader treats redefinition as an error, so keep the first
# definition of each circuit.  Leaf subckts also use symbolic W=nw/L=nl
# parameters which the reader cannot parse; they are replaced with a numeric
# dummy (real values come from the instantiating cell, so flattening is
# unaffected).
def validate_spice_circuit_definitions(path)
  definitions = {}
  current_name = nil
  current_lines = nil
  File.foreach(path) do |line|
    if line =~ /^\s*\.SUBCKT\s+(\S+)/i
      raise "ambiguous nested .SUBCKT definition in #{path}" if current_name
      current_name = $1.downcase
      current_lines = [line]
    elsif current_name
      current_lines << line
      if line =~ /^\s*\.ENDS\b/i
        definition = current_lines.join
        if definitions.key?(current_name) && definitions[current_name] != definition
          raise "ambiguous repeated .SUBCKT #{current_name.inspect} in #{path}"
        end
        definitions[current_name] = definition
        current_name = nil
        current_lines = nil
      end
    end
  end
  raise "unterminated .SUBCKT #{current_name.inspect} in #{path}" if current_name
end

def dedup_spice(path)
  seen = {}
  out = []
  current = nil
  params = nil
  skipping = false
  flush_params = lambda do
    if params && params.any?
      out << ".PARAM #{params.sort.uniq.map { |p| "#{p}=1u" }.join(' ')}\n"
    end
  end
  File.foreach(path) do |line|
    if line =~ /^\s*\.SUBCKT\s+(\S+)/
      flush_params.call
      current = $1
      params = []
      skipping = seen[current] ? true : false
      next if skipping
      seen[current] = true
      out << line
    elsif line =~ /^\s*\.ENDS/
      flush_params.call
      current = nil
      params = nil
      skipping = false
      out << line
    else
      next if skipping
      if line =~ /^\s*[XMMQCRDL]/
        # collect symbolic (non-numeric) parameter VALUES used in this subckt
        line.scan(/(\w+)=(\S+)/) do |_k, v|
          params << v unless v =~ /\A[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?([munpf]|meg)?\z/
        end
        # KLayout's SPICE reader does not accept the CDL "X ... / SUB" call
        # syntax; drop the slash.  Symbolic W=nw etc. stay as-is - the .PARAM
        # declarations above make them resolvable and instance parameters
        # override them during flattening.
        line = line.sub(%r{\s+/\s+(\S+)}, ' \1')
      end
      out << line
    end
  end
  flush_params.call
  tmp = File.join(Dir.tmpdir, "ics55_schematic_#{File.basename(path)}")
  File.write(tmp, out.join)
  tmp
end

schematic_source = $schematic
unless NET_ONLY
  if $schematic
    schematic_source = $schematic
    validate_spice_circuit_definitions(schematic_source) if STRICT_HIERARCHY
    schematic(dedup_spice(schematic_source))
  else
    exts = %w[cdl spice sp cir]
    candidates = exts.map { |ext| "#{src.cell_name}.#{ext}" }
    netlists = candidates.select { |f| File.exist?(f) }
    if netlists.empty?
      error("Netlist not found, tried: #{candidates}")
    else
      schematic_source = netlists[0]
      validate_spice_circuit_definitions(schematic_source) if STRICT_HIERARCHY
      schematic(dedup_spice(schematic_source))
    end
  end
end
def source_top_pins(path, top_name)
  return [] unless path && File.file?(path.to_s)

  lines = File.readlines(path.to_s)
  start = lines.index do |line|
    match = line.match(/^\s*\.SUBCKT\s+(\S+)/i)
    match && match[1].casecmp(top_name.to_s).zero?
  end
  return [] unless start

  header = [lines[start]]
  index = start + 1
  while index < lines.length && lines[index].match?(/^\s*\+/)
    header << lines[index]
    index += 1
  end
  header.join(" ").split(/\s+/).drop(2).take_while do |name|
    !name.match?(/\A(?:PARAMS:|PARAMS)\z/i)
  end
end
def selected_bulk_net(override, pins, candidates, fallback)
  return override.to_s unless override.nil? || override.to_s.empty?

  candidates.each do |candidate|
    pin = pins.find { |name| name.casecmp(candidate).zero? }
    return pin if pin
  end
  fallback
end
def layout_has_layer?(layout, layer, datatype, root_cell)
  index = layout.find_layer(layer, datatype)
  return false if index.nil? || index < 0

  found = false
  visited = {}
  visit = lambda do |cell|
    unless found || visited[cell.cell_index]
      visited[cell.cell_index] = true
      cell.shapes(index).each do |shape|
        next if shape.is_text?
        found = true
        break
      end
      cell.each_inst { |instance| visit.call(layout.cell(instance.cell_index)) } unless found
    end
  end
  visit.call(root_cell)
  found
end
metal_stack_request = ($metal_stack || "auto").to_s.downcase
unless %w[auto m1_m5 t4].include?(metal_stack_request)
  raise "metal_stack must be auto, m1_m5, or t4; got #{metal_stack_request.inspect}"
end
if metal_stack_request == "auto"
  source_top = src && src.cell_obj
  source_layout = source_top && source_top.layout
  has_t4_stack = source_top &&
    (layout_has_layer?(source_layout, 102, 1, source_top) || layout_has_layer?(source_layout, 103, 1, source_top))
  METAL_STACK = has_t4_stack ? "t4" : "m1_m5"
else
  METAL_STACK = metal_stack_request
end
puts "Metal stack: #{METAL_STACK} (requested #{metal_stack_request})"
top_ports = source_top_pins(schematic_source, src.cell_name)
BULK_GROUND_NET = selected_bulk_net($bulk_ground_net, top_ports, %w[gnd GND VSS], "VSS")
BULK_POWER_NET = selected_bulk_net($bulk_power_net, top_ports, %w[vdd VDD], "VDD")
puts "Bulk aliases: ground=#{BULK_GROUND_NET} power=#{BULK_POWER_NET}"

unless NET_ONLY
  if $target_netlist
    target_netlist($target_netlist, write_spice(SPICE_WITH_NET_NAMES, SPICE_WITH_COMMENTS),
                   "Extracted by KLayout with the ICsprout55 LVS runset")
  else
    target_netlist("#{src.cell_name}_extracted.cir", write_spice(SPICE_WITH_NET_NAMES, SPICE_WITH_COMMENTS),
                   "Extracted by KLayout with the ICsprout55 LVS runset")
  end
end

#-----------------------------------------------------------------------------------------
# Layers + derivations + connectivity + extraction
#
# The macro preprocessor does not expand "include" directives reliably in batch
# mode, so the rule modules are concatenated and evaluated in ONE scope (keeps
# the LVS context as self and the deck locals in scope).
#-----------------------------------------------------------------------------------------

SCRIPT_DIR = File.expand_path(File.dirname(__FILE__))

LVS_MODULE_FILES = [
  'rule_decks/layers_definitions.lvs',
  'rule_decks/general_derivations.lvs',
  'rule_decks/mos_derivations.lvs',
  'rule_decks/res_diode_derivations.lvs',
  'rule_decks/devices_connections.lvs',
  'rule_decks/mos_extraction.lvs',
  'rule_decks/res_diode_extraction.lvs',
  'rule_decks/combine_fingers.lvs'
]

lvs_assembled = LVS_MODULE_FILES.map { |f| File.read(File.join(SCRIPT_DIR, f)) }.join("\n")
eval(lvs_assembled, binding, 'ics55_assembled_lvs')

#-----------------------------------------------------------------------------------------
# Netlist comparison
#-----------------------------------------------------------------------------------------

# A flat, circuit-name-equal mapping is required for hierarchy mode; the default
# strict mode keeps the historical schematic flattening path.

# Establish a one-to-one correspondence for every extracted/reference circuit
# and every named circuit boundary. Ambiguity is an inconclusive strict failure;
# the hierarchy mode never guesses module equivalence or drops a boundary.
def strict_circuit_index(netlist, side)
  index = {}
  netlist.each_circuit do |circuit|
    key = circuit.name.to_s.downcase
    if key.empty? || index.key?(key)
      return [nil, "ambiguous #{side} circuit name #{circuit.name.inspect}"]
    end
    index[key] = circuit
  end
  [index, nil]
end

def strict_pin_index(circuit, side)
  index = {}
  circuit.each_pin do |pin|
    key = pin.name.to_s.downcase
    if key.empty? || index.key?(key)
      return [nil, "ambiguous #{side} pin name #{pin.name.inspect} in #{circuit.name}"]
    end
    index[key] = pin
  end
  [index, nil]
end


def strict_hierarchy_pairs(layout_netlist, reference_netlist)
  layout_index, error = strict_circuit_index(layout_netlist, "layout")
  return [nil, error] if error
  reference_index, error = strict_circuit_index(reference_netlist, "reference")
  return [nil, error] if error

  layout_names = layout_index.keys.sort
  reference_names = reference_index.keys.sort
  unless layout_names == reference_names
    layout_only = layout_names - reference_names
    reference_only = reference_names - layout_names
    return [nil, "circuit sets differ (layout-only=#{layout_only.inspect}, reference-only=#{reference_only.inspect})"]
  end
  pairs = []
  layout_names.each do |name|
    layout_circuit = layout_index[name]
    reference_circuit = reference_index[name]
    layout_pins, error = strict_pin_index(layout_circuit, "layout")
    return [nil, error] if error
    reference_pins, error = strict_pin_index(reference_circuit, "reference")
    return [nil, error] if error
    unless layout_pins.keys.sort == reference_pins.keys.sort
      return [nil, "boundary pins differ for #{name} (layout=#{layout_pins.keys.sort.inspect}, reference=#{reference_pins.keys.sort.inspect})"]
    end

    pin_pairs = []
    layout_pins.keys.sort.each do |pin_name|
      layout_net = layout_circuit.net_for_pin(layout_pins[pin_name].id)
      reference_net = reference_circuit.net_for_pin(reference_pins[pin_name].id)
      unless layout_net && reference_net
        return [nil, "unconnected boundary pin #{pin_name} in #{name}"]
      end
      pin_pairs << [layout_net, reference_net]
    end
    pairs << [layout_circuit, reference_circuit, pin_pairs]
  end
  [pairs, nil]
end

# The schematic is flattened in the default strict mode. The opt-in hierarchy
# path leaves it intact and is allowed only after exact module/boundary mapping.
schematic.flatten unless NET_ONLY || STRICT_HIERARCHY

# The released std cells have no in-cell well/substrate taps.  Tie physical
# bulk regions to the selected top-level rail names; choose those from the top
# CDL pins when present, falling back to the standard-cell VSS/VDD convention.
if WELL_TIES
  netlist.each_circuit do |c|
    by_name = Hash.new { |h, k| h[k] = [] }
    c.each_net { |n| by_name[n.name] << n unless n.name.empty? }
    by_name.each_value do |nets|
      next if nets.size < 2
      first = nets.shift
      nets.each { |n| c.join_nets(first, n) }
    end
    power_net = by_name[BULK_POWER_NET]&.first
    well_net = by_name.find { |name, _nets| name.casecmp("VNW").zero? }&.last&.first
    c.join_nets(power_net, well_net) if power_net && well_net
  end
end

# multi-finger combine pass (rule_decks/combine_fingers.lvs)
align unless NET_ONLY || STRICT_TOPOLOGY

# The SPICE reader canonicalizes the reference root name to upper case, while
# the GDS primary cell retains its spelling. Normalize only a case-equivalent
# root identifier; it does not rewrite signal, pin, or device labels.
unless NET_ONLY
  root_name = src.cell_name.to_s
  extracted_top = netlist.each_circuit.find { |circuit| circuit.name.to_s.casecmp(root_name).zero? }
  reference_top = schematic.each_circuit.find { |circuit| circuit.name.to_s.casecmp(root_name).zero? }
  if extracted_top && reference_top
    reference_top.name = extracted_top.name
  end
end
# Calibre PORT DEPTH 0: only direct top-cell text on a conductor creates a pin.
top_cell = src.cell_obj
layout = top_cell.layout
top_circuit = netlist.circuit_by_name(top_cell.name)
raise "Missing extracted top circuit #{top_cell.name.inspect}" unless top_circuit
port_layers = {81 => M1s, 82 => M2s, 83 => M3s, 84 => M4s}
if METAL_STACK == "t4"
  port_layers[102] = T4M1s
  port_layers[103] = T4M2s
else
  port_layers[85] = M5s
end
port_layers[122] = APs
port_layers[123] = APs
ports = Hash.new { |h, label| h[label] = {} }
direct_text_count = 0
port_layers.each do |number, conductor|
  [1, 6].each do |datatype|
    index = layout.find_layer(number, datatype)
    next if index.nil? || index < 0
    top_cell.each_shape(index) do |shape|
      next unless shape.is_text?
      direct_text_count += 1
      position = shape.text_pos
      point = RBA::DPoint.new(position.x * layout.dbu, position.y * layout.dbu)
      physical_net = l2n_data.probe_net(conductor.data, point)
      unless physical_net && physical_net.circuit == top_circuit
        raise "PORT DEPTH 0: #{shape.text_string.inspect} on #{number}/#{datatype} at #{point} has no top-level conductor"
      end
      net = top_circuit.net_by_cluster_id(physical_net.cluster_id)
      raise "PORT DEPTH 0: physical net for #{shape.text_string.inspect} was removed" unless net
      ports[shape.text_string][net.cluster_id] = net
    end
  end
end
disconnected = ports.select { |_label, nets| nets.size > 1 }
unless disconnected.empty?
  detail = disconnected.map { |label, nets| "#{label}=#{nets.keys.sort.join(',')}" }.join('; ')
  raise "PORT DEPTH 0: disconnected duplicate top labels: #{detail}"
end
old_pins = top_circuit.each_pin.to_a
old_pins.each { |pin| top_circuit.remove_pin(pin.id) }
ports.sort_by { |label, _nets| label }.each do |label, nets|
  pin = top_circuit.create_pin(label)
  top_circuit.connect_pin(pin, nets.values.first)
end
puts "PORT DEPTH 0: direct_texts=#{direct_text_count} ports=#{ports.size} previous_pins=#{old_pins.size}"

netlist.simplify if SIMPLIFY
netlist.combine_devices if COMBINE_DEVICES
netlist.purge if PURGE
if $target_netlist && (NET_ONLY || STRICT_TOPOLOGY)
  spice_writer = RBA::NetlistSpiceWriter.new
  spice_writer.use_net_names = true
  spice_writer.with_comments = true
  netlist.write($target_netlist, spice_writer, "Extracted by KLayout with the ICsprout55 LVS runset")
end
unless NET_ONLY
  schematic.simplify if SIMPLIFY
  schematic.combine_devices if COMBINE_DEVICES
  schematic.purge if PURGE
end

max_res(1e9)
min_caps(1e-18)
max_depth(8)
max_branch_complexity(1024)

# Device parameter comparison: L and all non-geometric parameters are
# compared exactly; W uses the official 10% relative tolerance (Calibre
# mos_err 0.1).  The released 7-track library is manually drawn and some
# cells deviate more than 5% from the CDL widths (INVX16H7* +27%,
# OAI33X0P5H7* +33%, INVX7H7* +14%, TBUFX8H7* 5-10%, NAND3BBX0P7H7* -14%);
# the 5-10% band now passes with a WARNING (audit_w below), the >10% band
# still fails.  Topology matching is exact.
%w[NM1P2_SVT_LP NM1P2_LVT_LP NM1P2_HVT_LP PM1P2_SVT_LP PM1P2_LVT_LP PM1P2_HVT_LP NM3P3_LP PM3P3_LP].each do |cls|
  begin
    dc = netlist.device_class_by_name(cls)
    next unless dc
    absolute_tolerance = STRICT_TOPOLOGY ? 1e-9 : 0.0
    width_relative_tolerance = STRICT_TOPOLOGY ? 0.0 : 0.10
    eq = RBA::EqualDeviceParameters.new(RBA::DeviceClassMOS4Transistor::PARAM_L, absolute_tolerance, 0.0)
    eq += RBA::EqualDeviceParameters.new(RBA::DeviceClassMOS4Transistor::PARAM_W, absolute_tolerance, width_relative_tolerance)
    dc.equal_parameters = eq
    sc = schematic.device_class_by_name(cls) unless NET_ONLY
    sc.equal_parameters = eq if sc
  rescue StandardError
  end
end

# W-deviation audit: after a passing compare, warn for every device whose W
# deviates more than warn_thr from the CDL (sorted same-class pairing when the
# device counts match, total-width comparison otherwise).  These are the
# foundry-drawn deviations accepted at the official 10% tolerance.
def audit_w(lnet, rnet, warn_thr = 0.05, tol = 0.10)
  lnet.each_circuit do |lc|
    rc = rnet.circuit_by_name(lc.name)
    next unless rc
    lw = Hash.new { |h, k| h[k] = [] }
    rw = Hash.new { |h, k| h[k] = [] }
    [lc, rc].each_with_index do |circ, _|
      circ.each_device do |d|
        next unless d.device_class.is_a?(RBA::DeviceClassMOS4Transistor)
        w = d.parameter(RBA::DeviceClassMOS4Transistor::PARAM_W)
        (circ == lc ? lw : rw)[d.device_class.name] << w
      end
    end
    lw.each do |cls, ws|
      rs = rw[cls]
      next if rs.nil? || rs.empty?
      ws = ws.sort
      rs = rs.sort
      if ws.size == rs.size
        ws.each_with_index do |w, i|
          dev = (w - rs[i]).abs / rs[i]
          if dev > warn_thr
            puts "WARNING: #{lc.name}: #{cls} device #{i + 1}/#{ws.size} W deviates #{(dev * 100).round(1)}% from CDL (accepted at the official #{tol * 100}% tolerance)"
          end
        end
      else
        dev = (ws.sum - rs.sum).abs / rs.sum
        if dev > warn_thr
          puts "WARNING: #{lc.name}: #{cls} total W deviates #{(dev * 100).round(1)}% from CDL (layout #{ws.size} devs vs CDL #{rs.size}, accepted at the official #{tol * 100}% tolerance)"
        end
      end
    end
  end
end

# Use mandatory boundary-net constraints, not heuristic net-name matching.
# This also removes top-port permutations from large generated-array searches.
if STRICT_TOPOLOGY && !NET_ONLY
  layout_top = top_circuit
  root_name = src.cell_name.to_s
  reference_top = schematic.each_circuit.find { |circuit| circuit.name.to_s.casecmp(root_name).zero? }
  strict_hierarchy_inconclusive = false
  if reference_top.nil?
    puts "STRICT_HIERARCHY=INCONCLUSIVE: reference root circuit #{root_name.inspect} is missing"
    strict_hierarchy_inconclusive = true
    strict_match = false
  end
  layout_pins = layout_top.each_pin.to_a
  reference_pins = reference_top ? reference_top.each_pin.to_a : []
  layout_by_name = layout_pins.to_h { |pin| [pin.name.downcase, pin] }
  reference_by_name = reference_pins.to_h { |pin| [pin.name.downcase, pin] }
  strict_ports_match = layout_by_name.size == layout_pins.size &&
                       reference_by_name.size == reference_pins.size &&
                       layout_by_name.keys.sort == reference_by_name.keys.sort
  puts "STRICT_TOP_PORTS: layout=#{layout_by_name.keys.sort.inspect} reference=#{reference_by_name.keys.sort.inspect}"
  comparer = RBA::NetlistComparer.new
  comparer.max_depth = 8
  comparer.max_branch_complexity = 1024
  comparer.max_resistance = 1e9
  comparer.min_capacitance = 1e-18
  comparer.dont_consider_net_names = true
  comparer.with_log = true
  l2n_data.reference = schematic

  unless strict_hierarchy_inconclusive
    if STRICT_HIERARCHY
      circuit_pairs, hierarchy_error = strict_hierarchy_pairs(netlist, schematic)
      if hierarchy_error
        puts "STRICT_HIERARCHY=INCONCLUSIVE: #{hierarchy_error}"
        strict_hierarchy_inconclusive = true
        strict_match = false
      else
        circuit_pairs.each do |layout_circuit, reference_circuit, pin_pairs|
          comparer.same_circuits(layout_circuit, reference_circuit)
          pin_pairs.each do |layout_net, reference_net|
            comparer.same_nets(layout_net, reference_net, true)
          end
        end
        puts "STRICT_HIERARCHY: circuits=#{circuit_pairs.size}, exact named module mapping and all boundary nets constrained"
        native_match = l2n_data.compare(comparer)
        strict_match = native_match && strict_ports_match
      end
    else
      comparer.same_circuits(layout_top, reference_top)
      (layout_by_name.keys & reference_by_name.keys).each do |name|
        layout_net = layout_top.net_for_pin(layout_by_name[name].id)
        reference_net = reference_top.net_for_pin(reference_by_name[name].id)
        if layout_net && reference_net
          comparer.same_nets(layout_net, reference_net, true)
        elsif layout_net || reference_net
          strict_ports_match = false
        end
      end
      native_match = l2n_data.compare(comparer)
      strict_match = native_match && strict_ports_match
    end
  end
end

if NET_ONLY
  puts "NET_ONLY: extraction complete."
elsif STRICT_HIERARCHY && strict_hierarchy_inconclusive
  puts "ICS55_LVS_COMPARE=INCONCLUSIVE"
  puts "ERROR: strict hierarchy correspondence was not established."
elsif (STRICT_TOPOLOGY ? strict_match : compare)
  puts "ICS55_LVS_COMPARE=PASS"
  puts "CONGRATULATIONS! Netlists match."
  audit_w(netlist, schematic)
else
  puts "ICS55_LVS_COMPARE=FAIL"
  puts "ERROR: netlists do not match."
end

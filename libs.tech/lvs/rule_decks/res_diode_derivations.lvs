#=========================================================================================
# ICsprout55 LVS resistor / diode derivations
#=========================================================================================

# Poly resistor re_ppo_sab_2t: POLY covered by the PPO marker (41/4), two CT straps
RES_POLY = POLY.and(PPO)

# ESD diode dio_3p3_pp_nw_lp: ESD region (55/1) inside NW, P+ (PP) anode
DIO_ANODE = ACT.and(PP).and(ESD)
DIO_CATHODE = NW

#=========================================================================================
# ICsprout55 LVS connectivity
#
# IMPORTANT: the raw ACT/PACT/NACT regions are NOT connected - they span gate +
# source + drain in one polygon, so connecting them to CT would short the
# transistor terminals.  Only the gate-excluded source/drain regions (NSD/PSD)
# and the poly (POLY_CON) enter the conductive stack.
#
# Conductor stack: NSD/PSD/POLY -> CT -> M1 -> V1 -> M2 ... M5 -> TV2 -> TM2.
# Implants (NP/PP/ESD/LVTN/...) are masks and carry no connectivity.
# Net labels: M1..M5 (81/6..85/6) and TM2 (103/6) name the nets. Top-level
# ports come only from direct top-cell text, selected by PORT DEPTH 0 in ics55.lvs.
# Default std-cell mode globally ties PSUB/NW to VSS/VDD; -rd no_well_ties=true
# uses CT-qualified physical taps and preserves isolated well islands.
#=========================================================================================

# --- source/drain and poly to contact union ----------------------------------------

connect(N_SD, CTs)
connect(P_SD, CTs)
connect(CTs, N_TAP)
connect(CTs, P_TAP)
connect(NIO_SD, CTs)
connect(PIO_SD, CTs)
connect(POLY_CON, CTs)

# --- gate terminal layers into the poly net ----------------------------------------

connect(NGATE, POLY_CON)
connect(PGATE, POLY_CON)
connect(NIOGATE, POLY_CON)
connect(PIOGATE, POLY_CON)
connect(NGATE_SVT, NGATE)
connect(NGATE_LVT, NGATE)
connect(NGATE_HVT, NGATE)
connect(PGATE_SVT, PGATE)
connect(PGATE_LVT, PGATE)
connect(PGATE_HVT, PGATE)
connect(NIOGATE_REG, NIOGATE)
connect(PIOGATE_REG, PIOGATE)

# Junction active connects to contacts.  Resistor bodies stay outside the
# conductive connect graph; their extractors expose only endpoint terminals.
connect(DIO_ANODE, CTs)

# --- shared lower-metal stack ------------------------------------------------------

connect(CTs, M1s)
connect(M1s, VA1)
connect(VA1, M2s)
connect(M2s, VA2)
connect(VA2, M3s)
connect(M3s, VA3)
connect(VA3, M4s)

# The OpenRAM technology uses ordinary M1-M5.  The released Calibre profile
# uses M4-T4M1-T4M2; select exactly one stack to avoid cross-profile shorts.
if METAL_STACK == "t4"
  connect(M4s, T4V1s)
  connect(T4V1s, T4M1s)
  connect(T4M1s, T4V2s)
  connect(T4V2s, T4M2s)
  connect(T4M2s, PAS)
else
  connect(M4s, VA4)
  connect(VA4, M5s)
  connect(M5s, PAS)
end
connect(PAS, APs)

# --- pin labels --------------------------------------------------------------------

connect(M1s, M1LBL)
connect(M2s, M2LBL)
connect(M3s, M3LBL)
connect(M4s, M4LBL)
if METAL_STACK == "t4"
  connect(T4M1s, T4M1LBL)
  connect(T4M2s, T4M2LBL)
else
  connect(M5s, M5LBL)
end
connect(APs, ALPADLBL)
connect(APs, RDLLBL)

# Device bulk annotations are separate from physical body regions, avoiding
# direct soft-connects on a MOS device terminal.
connect(MOS_BULK_ANNOTATION, PSUB)
connect(MOS_BULK_ANNOTATION, NW)

if WELL_TIES
  # Standard-cell GDS has no local taps; the deck selects aliases from top CDL pins.
  connect_global(PSUB, BULK_GROUND_NET)
  connect_global(NW, BULK_POWER_NET)
else
  # Macro/analog mode follows contacted physical taps; isolated well islands
  # remain distinct and an uncontacted body is not silently tied to a rail.
  soft_connect_global(PSUB, "SUBSTRATE")
  connect(NW, NW)
  connect(PSUB, PSUB)
  soft_connect(N_TAP, NW)
  soft_connect(P_TAP, PSUB)
end

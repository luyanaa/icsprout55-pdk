#=========================================================================================
# ICsprout55 LVS layer definitions
#
# Layer numbers per libs.tech/klayout/tech/ics55.map.
#=========================================================================================

# --- input layers ------------------------------------------------------------------

ACT    = input(2, 1)
NW     = input(9, 1)
LVTN   = input(17, 1)
LVTP   = input(18, 1)
HVTN   = input(21, 1)
HVTP   = input(22, 1)
TGOX   = input(28, 1)  # official 28/1 (3.3V IO gate oxide); was misaliased IOWELL
POLY   = input(41, 1)
PPO    = input(41, 4)
NP     = input(52, 1)
PP     = input(53, 1)
ESD    = input(55, 1)
SAB    = input(71, 1)  # official 71/1 (silicide block); was misaliased IOACT
DGOX   = input(27, 1)  # official 27/1 (2.5V IO gate oxide)
CTbar  = input(72, 7)
CTopcblk = input(72, 5)
DIODE  = input(191, 12)
RV     = input(120, 1)
CB     = input(121, 1)
RDL    = input(123, 1)
COVER  = input(124, 1)
IOACT  = ACT.and(TGOX)  # official IO active = ACT under the 3.3V gate oxide
CT     = input(72, 1)
M1     = input(81, 1)
M1LBL  = input(81, 6)
M2     = input(82, 1)
M2LBL  = input(82, 6)
M3     = input(83, 1)
M3LBL  = input(83, 6)
M4     = input(84, 1)
M4LBL  = input(84, 6)
M5     = input(85, 1)
M5LBL  = input(85, 6)
V1     = input(91, 1)
V2     = input(92, 1)
V3     = input(93, 1)
V4     = input(94, 1)
TM2    = input(103, 1)
TM2LBL = input(103, 6)
TV2    = input(113, 1)
ALPAD  = input(122, 1)  # official 122/1 aluminium pad (was 121/1)

# --- derived layers (FreePDK45 convention) -----------------------------------------

# n+/p+ active
NACT = ACT.and(NP)
PACT = ACT.and(PP)

# IO active (3.3V)
NIOACT = IOACT.and(NP)
PIOACT = IOACT.and(PP)

# gates, source/drain
NGATE = POLY.and(NACT)
PGATE = POLY.and(PACT)
NIOGATE = POLY.and(NIOACT)
PIOGATE = POLY.and(PIOACT)
NSD = NACT.not(NGATE)
PSD = PACT.not(PGATE)
NIOSD = NIOACT.not(NIOGATE)
PIOSD = PIOACT.not(PIOGATE)

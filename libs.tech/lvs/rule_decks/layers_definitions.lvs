#=========================================================================================
# ICsprout55 LVS layer definitions
#
# Layer numbers per libs.tech/klayout/tech/ics55.map.
#=========================================================================================

# --- input layers ------------------------------------------------------------------

ACT      = input(2, 1)
ACTDUM   = input(2, 2)
ACTDUMB  = input(2, 3)
ACTRES   = input(2, 4)
NW       = input(9, 1)
ULLD     = input(152, 12)
UD       = input(153, 12)
OD       = input(154, 12)
LVTN     = input(17, 1)
LVTP     = input(18, 1)
HVTN     = input(21, 1)
HVTP     = input(22, 1)
DGOX     = input(27, 1)
TGOX     = input(28, 1)
POLY     = input(41, 1)
POLYDUM  = input(41, 2)
PPO      = input(41, 4)
HRP      = input(54, 1)
HRPBLK   = input(385, 12)
NP       = input(52, 1)
PP       = input(53, 1)
ESD      = input(55, 1)
SAB      = input(71, 1)
ESDIOE   = input(232, 12)
VARAM    = input(193, 12)
BJT      = input(195, 12)
SRAMALL  = input(171, 12)
PSUB_MARKER = input(261, 12)
RES3TPOLY = input(329, 12)
RESCKTLVS = input(314, 12)

CT      = input(72, 1)
CTbar   = input(72, 7)
CTopcblk = input(72, 5)
M1      = input(81, 1)
M1DUM   = input(81, 2)
M1RES   = input(81, 4)
M1LBL   = input(81, 6)
M2      = input(82, 1)
M2DUM   = input(82, 2)
M2RES   = input(82, 4)
M2LBL   = input(82, 6)
M3      = input(83, 1)
M3DUM   = input(83, 2)
M3RES   = input(83, 4)
M3LBL   = input(83, 6)
M4      = input(84, 1)
M4DUM   = input(84, 2)
M4RES   = input(84, 4)
M4LBL   = input(84, 6)
M5      = input(85, 1)
M5DUM   = input(85, 2)
M5RES   = input(85, 4)
M5LBL   = input(85, 6)
V1      = input(91, 1)
V1BAR   = input(91, 7)
V2      = input(92, 1)
V2BAR   = input(92, 7)
V3      = input(93, 1)
V3BAR   = input(93, 7)
V4      = input(94, 1)
V4BAR   = input(94, 7)
T4M1    = input(102, 1)
T4M1DUM = input(102, 2)
T4M1RES = input(102, 4)
T4M1LBL = input(102, 6)
T4V1    = input(112, 1)
T4V1BAR = input(112, 7)
T4M2    = input(103, 1)
T4M2DUM = input(103, 2)
T4M2RES = input(103, 4)
T4M2LBL = input(103, 6)
T4V2    = input(113, 1)
T4V2BAR = input(113, 7)
TM2     = T4M2
TM2LBL  = T4M2LBL
TV2     = T4V2
TV2BAR  = T4V2BAR
ALPAD   = input(122, 1)
ALPADRES = input(122, 4)
ALPADLBL = input(122, 6)
RDLLBL   = input(123, 6)
CB      = input(121, 1)
RV      = input(120, 1)
RDL     = input(123, 1)
COVER   = input(124, 1)

DIODE = input(191, 12)

# --- source-faithful contacts, vias, and conductor regions --------------------------

CTs = CT.or(CTbar)
VA1 = V1.or(V1BAR)
VA2 = V2.or(V2BAR)
VA3 = V3.or(V3BAR)
VA4 = V4.or(V4BAR)
T4V1s = T4V1.or(T4V1BAR)
T4V2s = T4V2.or(T4V2BAR)
TV2s = T4V2s
PAS = CB.or(RV)

# Calibre LVS includes dummy metal and removes marked resistor regions from
# the conductive nets.  Keep the two terminal classes distinct for extraction.
rm1_2t = M1.and(M1RES).not(RESCKTLVS)
rm1_3t = M1.and(M1RES).and(RESCKTLVS)
rm2_2t = M2.and(M2RES).not(RESCKTLVS)
rm2_3t = M2.and(M2RES).and(RESCKTLVS)
rm3_2t = M3.and(M3RES).not(RESCKTLVS)
rm3_3t = M3.and(M3RES).and(RESCKTLVS)
rm4_2t = M4.and(M4RES).not(RESCKTLVS)
rm4_3t = M4.and(M4RES).and(RESCKTLVS)
rm5_2t = M5.and(M5RES).not(RESCKTLVS)
rm5_3t = M5.and(M5RES).and(RESCKTLVS)
rtm1_2t = T4M1.and(T4M1RES).not(RESCKTLVS)
rtm1_3t = T4M1.and(T4M1RES).and(RESCKTLVS)
rtm2_2t = T4M2.and(T4M2RES).not(RESCKTLVS)
rtm2_3t = T4M2.and(T4M2RES).and(RESCKTLVS)
M1s = M1.or(M1DUM).not(rm1_2t.or(rm1_3t))
M2s = M2.or(M2DUM).not(rm2_2t.or(rm2_3t))
M3s = M3.or(M3DUM).not(rm3_2t.or(rm3_3t))
M4s = M4.or(M4DUM).not(rm4_2t.or(rm4_3t))
M5s = M5.or(M5DUM).not(rm5_2t.or(rm5_3t))
T4M1s = T4M1.or(T4M1DUM).not(rtm1_2t.or(rtm1_3t))
T4M2s = T4M2.or(T4M2DUM).not(rtm2_2t.or(rtm2_3t))
TM2s = T4M2s

# Calibre's APs conductor excludes both two- and three-terminal marked RDL
# resistor regions; the partition is retained for the corresponding devices.
RDL_ALL = ALPAD.or(RDL)
RDL_R_2T = RDL_ALL.and(ALPADRES).not(RESCKTLVS)
RDL_R_3T = RDL_ALL.and(ALPADRES).and(RESCKTLVS)
APs = RDL_ALL.not(RDL_R_2T.or(RDL_R_3T))

# Source device gate construction: contact-qualified active, poly resistors
# removed, and the n/p gate split made by implant and well.
AA = ACT.or(ACTDUM)
PO = POLY.or(POLYDUM)
POLY_RES = PO.and(PPO.or(HRPBLK))
POLY_CON = PO.not(POLY_RES)
AA_EFF_REG = AA.interacting(CTs).or(AA.interacting(PO.interacting(CTs)))
NON_RES_POLY = PO.not(POLY_RES)
G_POLY = NON_RES_POLY.and(AA)
PO_GATE = G_POLY.and(AA_EFF_REG).not(POLYDUM)

# n+/p+ active and gate regions
NACT = AA.and(NP)
PACT = AA.and(PP)
NGATE = PO_GATE.and(NP).not(NW)
PGATE = PO_GATE.and(PP).and(NW)

# IO active and gate regions for the released TGOX_33 profile
IOACT = ACT.and(TGOX)
NIOACT = AA.and(TGOX).and(NP)
PIOACT = AA.and(TGOX).and(PP)
NIOGATE = NGATE.and(TGOX).not(DGOX)
PIOGATE = PGATE.and(TGOX).not(DGOX)

# Source/drain regions exclude gate geometry; physical taps remain separate.
NSD = NACT.not(NGATE)
PSD = PACT.not(PGATE)
NIOSD = NIOACT.not(NIOGATE)
PIOSD = PIOACT.not(PIOGATE)
N_SD = NSD.not(NW)
P_SD = PSD.and(NW)
N_TAP = NSD.and(NW).interacting(CTs)
P_TAP = PSD.not(NW).interacting(CTs)
NIO_SD = NIOSD.not(NW)
PIO_SD = PIOSD.and(NW)


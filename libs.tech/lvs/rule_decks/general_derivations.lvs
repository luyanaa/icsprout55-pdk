#=========================================================================================
# ICsprout55 LVS general derivations
#
# Substrate is the layout extent (expanded like Calibre's BULK = SIZE(EXTENT)
# BY 0.1) with n-well holes removed. The source extent lets a body in a leaf
# meet a real substrate tap in its wrapper; the fallback supports layer-only
# runs with no layout source.
SUBSTRATE_EXTENT = if defined?(src) && src
                     src.extent.sized(0.1)
                   else
                     ACT.extents(0.1)
                   end
PSUB = SUBSTRATE_EXTENT.not(NW)
# Keep each MOS body annotation separate by polarity.  A single virtual layer
# connected to both physical body regions bridges p-substrate and n-well.
NMOS_BULK_ANNOTATION = make_layer
PMOS_BULK_ANNOTATION = make_layer

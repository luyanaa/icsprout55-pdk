#=========================================================================================
# ICsprout55 LVS MOS derivations
#
# Gate selectors for the released Calibre TGOX_33 profile.
#
# The core oxide excludes both IO oxides.  Core SVT and IO selectors use the
# distinct source-defined nonSVT / nonSVT_esd marker sets; ESDIOE is excluded
# from core SVT but intentionally retained by the TGOX IO selector.
CORE_NGATE = NGATE.not(DGOX).not(TGOX)
CORE_PGATE = PGATE.not(DGOX).not(TGOX)

NON_SVT = LVTN.or(LVTP).or(HVTN).or(HVTP).or(SRAMALL).or(BJT).or(ACTRES).or(VARAM).or(ULLD).or(ESDIOE)
NON_SVT_ESD = LVTN.or(LVTP).or(HVTN).or(HVTP).or(SRAMALL).or(BJT).or(ACTRES).or(VARAM).or(ULLD)

NGATE_SVT = CORE_NGATE.not(PSUB_MARKER).not(OD).not(UD).not(NON_SVT)
PGATE_SVT = CORE_PGATE.not(PSUB_MARKER).not(OD).not(UD).not(NON_SVT)

NGATE_LVT = CORE_NGATE.and(LVTN).not(PSUB_MARKER).not(SRAMALL).not(OD).not(UD)
PGATE_LVT = CORE_PGATE.and(LVTP).not(PSUB_MARKER).not(SRAMALL).not(OD).not(UD)
NGATE_HVT = CORE_NGATE.and(HVTN).not(PSUB_MARKER).not(SRAMALL).not(OD).not(UD).not(ULLD)
PGATE_HVT = CORE_PGATE.and(HVTP).not(PSUB_MARKER).not(SRAMALL).not(OD).not(UD).not(ULLD)

# The official TGOX IO nonSVT_esd selector does not exclude ESDIOE.
NIOGATE_REG = NIOGATE.not(PSUB_MARKER).not(OD).not(UD).not(NON_SVT_ESD)
PIOGATE_REG = PIOGATE.not(PSUB_MARKER).not(OD).not(UD).not(NON_SVT_ESD)

#=========================================================================================
# ICsprout55 LVS MOS derivations
#
# Exclusions keep the RF/ESD/pad-specific poly out of the regular MOS extraction
# (IHP-style); the ICS55 release contains only the layers below, so the
# exclusion set is minimal but kept as a hook for the IO library.
#=========================================================================================

# Poly used for resistors (PPO-marked) must not extract as a gate
POLY_RES = POLY.and(PPO)
POLY_CON = POLY.not(POLY_RES)

# ESD-diode anode poly is inside the ESD region - exclude from regular gates
ESD_GATE = POLY.and(ESD)

# Regular gates (excluding resistor / ESD poly)
NGATE_SVT = NGATE.not(LVTN).not(HVTN).not(POLY_RES).not(ESD_GATE)
NGATE_LVT = NGATE.and(LVTN).not(POLY_RES).not(ESD_GATE)
NGATE_HVT = NGATE.and(HVTN).not(POLY_RES).not(ESD_GATE)
PGATE_SVT = PGATE.not(LVTP).not(HVTP).not(POLY_RES).not(ESD_GATE)
PGATE_LVT = PGATE.and(LVTP).not(POLY_RES).not(ESD_GATE)
PGATE_HVT = PGATE.and(HVTP).not(POLY_RES).not(ESD_GATE)

# IO gates (3.3V devices are SVT-only per the released CDL)
NIOGATE_REG = NIOGATE.not(POLY_RES)
PIOGATE_REG = PIOGATE.not(POLY_RES)

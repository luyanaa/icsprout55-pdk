#=========================================================================================
# ICsprout55 LVS resistor / diode extraction
#
# re_ppo_sab_2t: poly resistor - POLY + PPO marker, terminals = the CT straps at
# the resistor ends (two CT regions on the poly).
#   Rsq ~ 850 ohm/sq (derived, libs.tech/README.md) - schematic resistance
#   comparison is disabled via max_res() in the main deck.
#
# dio_3p3_pp_nw_lp: ESD diode - P+ anode in NW.
#=========================================================================================

extract_devices(resistor('RE_PPO_SAB_2T', 850.0),
                { 'R' => RES_POLY,
                  'A' => RES_POLY, 'B' => RES_POLY,
                  'tA' => CT, 'tB' => CT,
                  'C' => PSUB })

extract_devices(diode('DIO_3P3_PP_NW_LP'),
                { 'P' => DIO_ANODE, 'N' => DIO_CATHODE,
                  'tP' => CT, 'tN' => NW })

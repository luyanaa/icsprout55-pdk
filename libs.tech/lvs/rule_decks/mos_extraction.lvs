#=========================================================================================
# ICsprout55 LVS MOS extraction
#
# Device classes are named exactly like the released CDL models so the
# schematic netlist comparison is direct:
#   nm1p2_svt_lp / nm1p2_lvt_lp / nm1p2_hvt_lp, pm1p2_* (core, L=60nm)
#   nm3p3_lp / pm3p3_lp (IO, L=400-650nm)
#
# KLayout mos4 terminals: SD (source/drain), G (gate), tS/tD (contact regions
# on source/drain), tG (contact region on gate), W (well/substrate).
#=========================================================================================

# --- core NMOS --------------------------------------------------------------------

extract_devices(mos4('NM1P2_SVT_LP'),
                { 'SD' => NSD, 'G' => NGATE_SVT,
                  'tS' => NSD, 'tD' => NSD, 'tG' => POLY_CON,
                  'W' => PSUB })
extract_devices(mos4('NM1P2_LVT_LP'),
                { 'SD' => NSD, 'G' => NGATE_LVT,
                  'tS' => NSD, 'tD' => NSD, 'tG' => POLY_CON,
                  'W' => PSUB })
extract_devices(mos4('NM1P2_HVT_LP'),
                { 'SD' => NSD, 'G' => NGATE_HVT,
                  'tS' => NSD, 'tD' => NSD, 'tG' => POLY_CON,
                  'W' => PSUB })

# --- core PMOS --------------------------------------------------------------------

extract_devices(mos4('PM1P2_SVT_LP'),
                { 'SD' => PSD, 'G' => PGATE_SVT,
                  'tS' => PSD, 'tD' => PSD, 'tG' => POLY_CON,
                  'W' => NW })
extract_devices(mos4('PM1P2_LVT_LP'),
                { 'SD' => PSD, 'G' => PGATE_LVT,
                  'tS' => PSD, 'tD' => PSD, 'tG' => POLY_CON,
                  'W' => NW })
extract_devices(mos4('PM1P2_HVT_LP'),
                { 'SD' => PSD, 'G' => PGATE_HVT,
                  'tS' => PSD, 'tD' => PSD, 'tG' => POLY_CON,
                  'W' => NW })

# --- IO MOS (3.3V) ----------------------------------------------------------------

extract_devices(mos4('NM3P3_LP'),
                { 'SD' => NIOSD, 'G' => NIOGATE_REG,
                  'tS' => NIOSD, 'tD' => NIOSD, 'tG' => POLY_CON,
                  'W' => PSUB })
extract_devices(mos4('PM3P3_LP'),
                { 'SD' => PIOSD, 'G' => PIOGATE_REG,
                  'tS' => PIOSD, 'tD' => PIOSD, 'tG' => POLY_CON,
                  'W' => NW })

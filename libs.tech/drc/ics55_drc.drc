#=========================================================================================
# ICsprout55 (ICS55) KLayout DRC runset - provisional
#
# Port of the iDRC check set (Mulan PSL v2, openecos-projects/ecc-tools) to the
# KLayout DRC language, with rule values from the released ICS55 PDK:
#   - BEOL values are exact tech-LEF values (prtech/techLEF/N551P6M.lef);
#   - FEOL values are measured from the released std-cell / IO GDS
#     (libs.tech/drc/measurements_*.json, regenerated by tools/measure_gds.rb);
#   - values not present in any released source are marked `derived`/`tbd` in
#     rule_decks/ics55_rules.json and are NOT foundry data.
#
# This is NOT a foundry DRC deck (the foundry DRC rule deck is not released).
#
# Usage:
#   klayout -b -r ics55_drc.drc -rd input=<layout.gds> \
#       [-rd top=<topcell>] [-rd report=<out.lyrdb>] \
#       [-rd no_feol=true] [-rd no_beol=true] [-rd no_advanced=true] \
#       [-rd no_density=true] \
#       [-rd no_antenna=true] [-rd no_grid=true] [-rd tables=beol] [-z]
#
# Switches:
#   tables  : 'main' (default) | subset: feol beol grid advanced antenna
#   no_*    : disable a table family
#   antenna : enable antenna checks (ratios are TBD - see rule JSON)
#   run_mode: deep (default) | flat | tiling
#=========================================================================================

require 'json'
require 'etc'

#-----------------------------------------------------------------------------------------
# File setup
#-----------------------------------------------------------------------------------------

if $input
  if $top
    source($input, $top)
  else
    source($input)
  end
end

if $report
  report("ICsprout55 DRC", $report)
else
  report("ICsprout55 DRC", "ics55_drc.lyrdb")
end

#-----------------------------------------------------------------------------------------
# Switches
#-----------------------------------------------------------------------------------------

def bool_check?(obj)
  obj.to_s.downcase == 'true'
end

TABLES = ($tables || 'main').split
FEOL = !bool_check?($no_feol)
BEOL = !bool_check?($no_beol)
GRID = !bool_check?($no_grid)
ANTENNA = !bool_check?($no_antenna)
ADVANCED = !bool_check?($no_advanced)
DENSITY = !bool_check?($no_density)
MOM = !bool_check?($no_mom)
CELL_EXCLUSION = bool_check?($cell_exclusion)

case $run_mode
when 'tiling'
  tiles(500.um)
  tile_borders(30.um)
when 'flat'
  flat
else
  deep
end

threads($threads || Etc.nprocessors)

#-----------------------------------------------------------------------------------------
# Rule values (JSON, one source of truth)
#-----------------------------------------------------------------------------------------

SCRIPT_DIR = File.expand_path(File.dirname(__FILE__))

def load_rules
  path = File.join(SCRIPT_DIR, 'rule_decks', 'ics55_rules.json')
  data = JSON.parse(File.read(path))
  [data['drc_rules'], data['meta']]
end

DRC_RULES, RULE_META = load_rules

def rval(key)
  v = DRC_RULES[key]
  raise "missing rule value: #{key}" if v.nil?
  v.to_f
end

#-----------------------------------------------------------------------------------------
# Layer definitions + derived layers (included via MODULE_FILES below)
#-----------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------
# Rule modules (one per iDRC check family / process layer group)
#
# The macro preprocessor does not expand "include" directives reliably in batch
# mode, and separate eval() calls do not share locals.  The layer definitions
# and rule modules are therefore concatenated and evaluated in ONE scope, which
# can still read the main deck's locals (DRC_RULES, rval, switches).
#-----------------------------------------------------------------------------------------

MODULE_FILES = [
  'rule_decks/layers_def.drc',
  # FEOL: wells, active, poly, implants, contacts (values: GDS-measured)
  'rule_decks/feol/01_wells.drc',
  'rule_decks/feol/02_active.drc',
  'rule_decks/feol/03_poly.drc',
  'rule_decks/feol/04_implant.drc',
  'rule_decks/feol/05_cont.drc',
  # BEOL: metals, vias, pads (values: tech LEF)
  'rule_decks/beol/06_metal.drc',
  'rule_decks/beol/07_via.drc',
  'rule_decks/beol/08_pad.drc',
  # Geometry: manufacturing grid
  'rule_decks/geometry/09_grid.drc',
  # Advanced approximations (EOL / jog / 45-deg): KLayout has no native EOL/jog/
  # min-step primitives; these use edge-based approximations (see file header).
  'rule_decks/advanced/10_eol_jog.drc',
  # Density (window-based; skipped on layouts smaller than the tile size)
  'rule_decks/density.drc',
  # MOM (marker-based; vacuous without the 60/1 MOM_MARKER)
  'rule_decks/mom.drc',
  # Antenna (values TBD - disabled unless -rd antenna=true)
  'rule_decks/antenna.drc'
]

assembled = MODULE_FILES.map { |f| File.read(File.join(SCRIPT_DIR, f)) }.join("\n")
eval(assembled, binding, 'ics55_assembled_modules')

puts "ICsprout55 DRC run completed (tables: #{TABLES.join(' ')})"

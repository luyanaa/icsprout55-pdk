#=========================================================================================
# ICsprout55 (ICS55) source-driven KLayout DRC port
#
# The deck emits predicates transcribed from the supplied Calibre source when
# their geometry, active profile, and exclusions are representable in KLayout.
# Unsupported Calibre-only semantics are omitted, not approximated by default.
# Provenance is recorded in rule_decks/ics55_rules.json.
#
# This is a partial source port, not formal Calibre equivalence. A matched
# Calibre run/report is required for cross-tool behavioral validation.
#
# Usage:
#   klayout -b -r ics55_drc.drc -rd input=<layout.gds> \
#       [-rd top=<topcell>] [-rd report=<out.lyrdb>] \
#       [-rd no_feol=true] [-rd no_beol=true] \
#       [-rd no_density=true] [-rd no_mom=true] [-rd tables=feol] [-z]
#
# Switches:
#   tables: main (default) or selected families: feol beol dummy_slot density
#           mom special
#   run_mode: deep (default) | flat | tiling
#   recommended: warn (default) | error | off.  Recommended rules are reported
#           as KLayout log warnings by default; error adds report categories.
#   Profile switches mirror the vendor deck: total_metal, top_metal, and the
#   T2V1_T2M1/T2V2_T2M2/T4V1_T4M1/T4V2_T4M2/T8V1_T8M1/T8V2_T8M2 pairs.  The
#   released profile is total_metal=6, top_metal=1, T4V2_T4M2=1; all other
#   top-metal families are implemented but disabled by their switches.
#=========================================================================================

require 'json'
require 'etc'

#-----------------------------------------------------------------------------------------
# File setup
#-----------------------------------------------------------------------------------------

if $input
  if $top
    source($input, $top)
  else
    source($input)
  end
end

if $report
  report("ICsprout55 DRC", $report)
else
  report("ICsprout55 DRC", "ics55_drc.lyrdb")
end

#-----------------------------------------------------------------------------------------
# Switches
#-----------------------------------------------------------------------------------------

def bool_check?(obj)
  obj.to_s.downcase == 'true'
end

TABLES = ($tables || 'main').split
MAIN_TABLE = TABLES.include?('main')
FEOL = !bool_check?($no_feol) && (MAIN_TABLE || TABLES.include?('feol'))
BEOL = !bool_check?($no_beol) && (MAIN_TABLE || TABLES.include?('beol'))
DENSITY = !bool_check?($no_density) && (MAIN_TABLE || TABLES.include?('density'))
MOM = !bool_check?($no_mom) && (MAIN_TABLE || TABLES.include?('mom'))
DUMMY_SLOT = MAIN_TABLE || TABLES.include?('dummy_slot')
SPECIAL = MAIN_TABLE || TABLES.include?('special')
CELL_EXCLUSION = bool_check?($cell_exclusion)

# Recommended rules follow the vendor OPEN_RECOMMENDED_ON switch.  The vendor
# default is NO (silent); this port defaults to warn so the checks still run
# and appear in the KLayout log without changing the report categories.
RECOMMENDED_MODE = ($recommended || 'warn').to_s.downcase
unless %w[warn error off].include?(RECOMMENDED_MODE)
  raise "recommended must be warn, error, or off (got #{RECOMMENDED_MODE})"
end
RECOMMENDED = RECOMMENDED_MODE != 'off'
RECOMMENDED_ERROR = RECOMMENDED_MODE == 'error'

# Vendor <Choice 2> process profile.  Accept both the vendor spelling and the
# lowercase -rd spelling; an unset switch keeps the released profile default.
def switch_raw(*names)
  names.each do |name|
    value = eval("$#{name}") rescue nil
    return value unless value.nil?
  end
  nil
end

def switch_flag(*args)
  default = [true, false].include?(args.last) ? args.pop : false
  raw = switch_raw(*args)
  raw.nil? ? default : bool_check?(raw)
end

def switch_int(*args)
  default = args.last.is_a?(Integer) ? args.pop : 0
  raw = switch_raw(*args)
  raw.nil? ? default : raw.to_i
end

TOTAL_METAL = switch_int('total_metal', 6)
TOP_METAL = switch_int('top_metal', 1)
# Vendor IO option: the released libraries use IO 1833; the IO 1825-only
# channel-length rules (PO_W_2c/2e/2f) are compiled in only when requested
# (-rd IO=1825, or -rd io_1825=true).
IO_OPTION = (switch_raw('IO') || '1833').to_s
IO_1825 = IO_OPTION.strip == '1825' || switch_flag('io_1825', false)
PROFILE = {
  'T2V1_T2M1' => switch_flag('T2V1_T2M1', 't2v1_t2m1', false),
  'T2V2_T2M2' => switch_flag('T2V2_T2M2', 't2v2_t2m2', false),
  'T4V1_T4M1' => switch_flag('T4V1_T4M1', 't4v1_t4m1', false),
  'T4V2_T4M2' => switch_flag('T4V2_T4M2', 't4v2_t4m2', true),
  'T8V1_T8M1' => switch_flag('T8V1_T8M1', 't8v1_t8m1', false),
  'T8V2_T8M2' => switch_flag('T8V2_T8M2', 't8v2_t8m2', false)
}
INNER_METALS = TOTAL_METAL - TOP_METAL
# The rule decks index these switches by layer number (CHECK_M[1] .. CHECK_M[8]),
# so index 0 is a placeholder.
CHECK_M = [false] + (1..8).map { |i| i <= INNER_METALS }
CHECK_V = [false] + (1..7).map { |i| i <= INNER_METALS - 1 }
CHECK_T2M1 = TOP_METAL == 2 && PROFILE['T2V1_T2M1']
CHECK_T2V1 = CHECK_T2M1
CHECK_T4M1 = TOP_METAL == 2 && PROFILE['T4V1_T4M1']
CHECK_T4V1 = CHECK_T4M1
CHECK_T8M1 = TOP_METAL == 2 && PROFILE['T8V1_T8M1']
CHECK_T8V1 = CHECK_T8M1
CHECK_T2M2 = PROFILE['T2V2_T2M2']
CHECK_T2V2 = CHECK_T2M2
CHECK_T4M2 = PROFILE['T4V2_T4M2']
CHECK_T4V2 = CHECK_T4M2
CHECK_T8M2 = PROFILE['T8V2_T8M2']
CHECK_T8V2 = CHECK_T8M2

case $run_mode
when 'tiling'
  tiles(500.um)
  tile_borders(30.um)
when 'flat'
  flat
else
  deep
end

threads($threads || Etc.nprocessors)

#-----------------------------------------------------------------------------------------
# Rule values (JSON, one source of truth)
#-----------------------------------------------------------------------------------------

SCRIPT_DIR = File.expand_path(File.dirname(__FILE__))

def load_rules
  path = File.join(SCRIPT_DIR, 'rule_decks', 'ics55_rules.json')
  data = JSON.parse(File.read(path))
  [data['drc_rules'], data['meta']]
end

DRC_RULES, RULE_META = load_rules

def rval(key)
  v = DRC_RULES[key]
  raise "missing rule value: #{key}" if v.nil?
  v.to_f
end

#-----------------------------------------------------------------------------------------
# Layer definitions + derived layers (included via MODULE_FILES below)
#-----------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------
# Rule modules (one per iDRC check family / process layer group)
#
# The macro preprocessor does not expand "include" directives reliably in batch
# mode, and separate eval() calls do not share locals.  The layer definitions
# and rule modules are therefore concatenated and evaluated in ONE scope, which
# can still read the main deck's locals (DRC_RULES, rval, switches).
#-----------------------------------------------------------------------------------------

MODULE_FILES = [
  'rule_decks/layers_def.drc',
  # FEOL: direct area, enclosure and coverage predicates; unsupported qualifiers stay off.
  'rule_decks/feol/01_wells.drc',
  'rule_decks/feol/02_active.drc',
  'rule_decks/feol/03_poly.drc',
  'rule_decks/feol/04_implant.drc',
  'rule_decks/feol/05_cont.drc',
  'rule_decks/feol/06_tg_dg.drc',
  'rule_decks/feol/07_sab.drc',
  'rule_decks/feol/08_hrp.drc',
  'rule_decks/feol/09_ulld.drc',
  'rule_decks/feol/10_voltage_implants.drc',
  'rule_decks/feol/11_resistors.drc',
  'rule_decks/feol/12_latchup.drc',
  # BEOL: only source predicates supported with their active profile/waivers.
  'rule_decks/beol/06_metal.drc',
  'rule_decks/beol/07_via.drc',
  'rule_decks/beol/08_pad.drc',
  'rule_decks/beol/09_sealring.drc',
  'rule_decks/beol/11_thick_metal.drc',
  'rule_decks/dummy_slot.drc',
  # Source-driven Density_rules for the configured 6-metal/T4M2 profile.
  'rule_decks/density.drc',
  # Source-backed MOM rules; unsupported source qualifiers are not approximated.
  'rule_decks/mom.drc',
  'rule_decks/special.drc'
]

assembled = MODULE_FILES.map { |f| File.read(File.join(SCRIPT_DIR, f)) }.join("\n")
eval(assembled, binding, 'ics55_assembled_modules')

puts "ICsprout55 DRC run completed (tables: #{TABLES.join(' ')})"

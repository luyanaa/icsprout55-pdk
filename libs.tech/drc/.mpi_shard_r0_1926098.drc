#=========================================================================================
# FEOL 04 - Implants
#
# Port source implant area checks only.  The remaining checks use layer-derived
# active/tap classes, edge coincidence, connectivity, and ABUT<90 qualifiers
# that are not equivalent to plain width/space/enclosure primitives.
#=========================================================================================

if FEOL
  NP.not(NP.with_area(0.12.um2, 1e9.um2)).not_inside(SRAMALL).not_inside(NODRC)
  NP.holes.not(NP.holes.with_area(0.12.um2, 1e9.um2)).not_inside(NODRC).output('implant.np.enclosed_area',
    "NP_A_2: NP enclosed area minimum 0.12 um^2; waived inside NODRC")
  PP.not(PP.with_area(0.12.um2, 1e9.um2)).not_inside(SRAMALL).not_inside(NODRC)
  PP.holes.not(PP.holes.with_area(0.12.um2, 1e9.um2)).not_inside(NODRC).output('implant.pp.enclosed_area',
    "PP_A_2: PP enclosed area minimum 0.12 um^2; waived inside NODRC")

  # Unsupported source rules: NP_W_1, NP_S_1 through NP_S_6, NP_EN_1
  # through NP_EN_3, NP_EX_1 / NP_EX_1a, NP_O_1, NP_A_3; PP_W_1,
  # PP_S_1 through PP_S_6, PP_EN_1 through PP_EN_3, PP_EX_1 / PP_EX_1a,
  # PP_O_1, PP_A_3, PP_R_1.  In particular, NP_W_1 allows single-point
  # interaction and source S rules require directional/abutment qualifiers.
end


#=========================================================================================
# Antenna checks
#
# FreePDK45-style antenna_check on the gate area vs. connected metal area.
# Requires connectivity (KLayout computes it from the connect() statements).
#
# NOTE: no antenna ratio data is released for ICS55.  The ratio 300:1 below is
# the FreePDK45 value and is NOT an ICS55 rule.  The antenna is a global
# full-chip netlist check and is skipped in -rd cell_exclusion=true mode (the
# clipped layers are non-hierarchical and cannot feed the netlist extraction).
#=========================================================================================

if ANTENNA && !CELL_EXCLUSION
  connect(GATES, POLY)
  connect(POLY, CT)
  connect(CT, M1)
  connect(M1, V1)
  connect(V1, M2)
  connect(M2, V2)
  connect(V2, M3)
  connect(M3, V3)
  connect(V3, M4)
  connect(M4, V4)
  connect(V4, M5)

  diode = NACT.not(NW)
  antenna_check(GATES, M1, rval('antenna_ratio').to_f, diode).output('antenna.m1',
    "antenna.m1: gate-to-M1 antenna ratio #{rval('antenna_ratio')} (TBD value, not foundry data)")
  antenna_check(GATES, M2, rval('antenna_ratio').to_f, diode).output('antenna.m2',
    "antenna.m2: gate-to-M2 antenna ratio #{rval('antenna_ratio')} (TBD value, not foundry data)")
  antenna_check(GATES, M3, rval('antenna_ratio').to_f, diode).output('antenna.m3',
    "antenna.m3: gate-to-M3 antenna ratio #{rval('antenna_ratio')} (TBD value, not foundry data)")
  antenna_check(GATES, M4, rval('antenna_ratio').to_f, diode).output('antenna.m4',
    "antenna.m4: gate-to-M4 antenna ratio #{rval('antenna_ratio')} (TBD value, not foundry data)")
  antenna_check(GATES, M5, rval('antenna_ratio').to_f, diode).output('antenna.m5',
    "antenna.m5: gate-to-M5 antenna ratio #{rval('antenna_ratio')} (TBD value, not foundry data)")
end

# MOM_CHECK / MOM_R_1 and MOM_R_2 for the configured 6-metal, T4M2-top profile.
# MOM_R_1 forbids a via intersecting the MOM finger marker on either adjacent
# metal; its violations are waived inside NODRC. Source via aliases include
# both the interior-cut and bar layers.
# The profile's active pairs are V1..V4 across MET1..MET5 and top via T4V2 on MET5.
if MOM
   mom_s1_space = rval('mom_s1_space')
   [
     ['V1', V1.or(V1BAR), M1, MET1MOM, 'MET1MOM'], ['V1', V1.or(V1BAR), M2, MET2MOM, 'MET2MOM'],
     ['V2', V2.or(V2BAR), M2, MET2MOM, 'MET2MOM'], ['V2', V2.or(V2BAR), M3, MET3MOM, 'MET3MOM'],
     ['V3', V3.or(V3BAR), M3, MET3MOM, 'MET3MOM'], ['V3', V3.or(V3BAR), M4, MET4MOM, 'MET4MOM'],
     ['V4', V4.or(V4BAR), M4, MET4MOM, 'MET4MOM'], ['V4', V4.or(V4BAR), M5, MET5MOM, 'MET5MOM'],
     ['T4V2', TV2.or(TV2BAR), M5, MET5MOM, 'MET5MOM']
   ].each do |via_name, via, metal, mom_marker, marker_name|
     via.and(mom_marker).not_inside(NODRC).output("mom.MOM_R_1.#{via_name}.#{marker_name}",
       "MOM_R_1: #{via_name} intersects #{marker_name} outside NODRC [ICsprout Calibre]")

     # MOM_S_1: a via outside MOMLVS1 must keep 0.11 um to MOM-marker metal
     # inside MOMLVS1. The source ABUT<90/SINGULAR/REGION qualifiers are not
     # reproduced.
     via.not(MOMLVS1).drc(separation(metal.and(mom_marker).and(MOMLVS1), transparent) < mom_s1_space.um)
       .not_inside(NODRC).output("mom.MOM_S_1.#{via_name}.#{marker_name}",
         "MOM_S_1: #{via_name} outside MOMLVS1 must keep #{mom_s1_space} um from #{marker_name}-covered metal outside NODRC [ICsprout Calibre]")
   end
 
   # MOM_S_1 is emitted above with the source's EXT construction approximated
   # by an unqualified KLayout separation check (the edge-pair reporting
   # qualifiers are not expressible).
   #
   # MOM_R_2 has active clauses for forbidden per-layer stack assignments,
   # labelled stacks missing a required MxMOM marker (source Y12..Y78) and
   # complete stacks missing their matching label (source Z12..Z78).
   # KLayout DRC has no polygon-with-text selection, so a label attached to a
   # MOMLVS1 polygon is approximated as MOMLVS1 interacting with its text.
   mom_layers = [MET1MOM, MET2MOM, MET3MOM, MET4MOM, MET5MOM, MET6MOM, MET7MOM, MET8MOM]
   mom_layer_names = %w[MET1MOM MET2MOM MET3MOM MET4MOM MET5MOM MET6MOM MET7MOM MET8MOM]
   mom_texts = labels(323, 12)
   mom_caps = %w[12 13 14 15 16 17 18 23 24 25 26 27 28 34 35 36 37 38 45 46 47 48 56 57 58 67 68 78]
   forbidden_caps = [
     %w[23 24 25 26 27 28 34 35 36 37 38 45 46 47 48 56 57 58 67 68 78],
     %w[34 35 36 37 38 45 46 47 48 56 57 58 67 68 78],
     %w[12 45 46 47 48 56 57 58 67 68 78],
     %w[12 13 23 56 57 58 67 68 78],
     %w[12 13 14 23 24 34 67 68 78],
     %w[12 13 14 15 23 24 25 34 35 45 78],
     %w[12 13 14 15 16 23 24 25 34 35 36 45 46 56],
     %w[12 13 14 15 16 17 23 24 25 26 27 34 35 36 37 45 46 47 56 57 67]
   ]
 
   mom_caps.each do |cap|
     cap_text = mom_texts.texts("momcap#{cap}")
     cap_region = MOMLVS1.interacting(cap_text)
 
     forbidden_caps.each_with_index do |caps, metal_index|
       next unless caps.include?(cap)
       marker = mom_layers[metal_index]
       marker.interacting(cap_region).not(SRINGBLK_SRC).output("mom.MOM_R_2.forbidden_stack.#{mom_layer_names[metal_index]}.#{cap}",
         "MOM_R_2: #{mom_layer_names[metal_index]} is forbidden for MOMLVS1 momcap#{cap} [ICsprout Calibre]")
     end
   end
 
   # A labelled stack must touch every MOM marker in its metal range (Y), and a
   # geometrically correct stack must carry the matching MOMLVS1 label (Z).
   # Extra MOM markers on any non-stack metal invalidate the Z candidate.
   mom_caps.each do |cap|
     first_metal = cap[0].to_i
     last_metal = cap[1].to_i
     required_markers = (first_metal..last_metal).map { |metal_index| mom_layers[metal_index - 1] }
     cap_text = mom_texts.texts("momcap#{cap}")

     labelled = MOMLVS1.interacting(cap_text)
     marked = required_markers.reduce(labelled) { |region, marker| region.interacting(marker) }
     labelled.not(marked).not(SRINGBLK_SRC).output("mom.MOM_R_2.missing_marker.#{cap}",
       "MOM_R_2: MOMLVS1 labelled momcap#{cap} must touch all required MxMOM markers [ICsprout Calibre]")

     candidate = required_markers.reduce(MOMLVS1) { |region, marker| region.interacting(marker) }
     other_markers = mom_layers.each_with_index.reject { |_, index| (first_metal - 1..last_metal - 1).include?(index) }.map(&:first)
     unless other_markers.empty?
       candidate = candidate.not_interacting(other_markers.reduce(:+))
     end
     candidate.not_interacting(cap_text).not(SRINGBLK_SRC).output("mom.MOM_R_2.label_stack.#{cap}",
       "MOM_R_2: MOMLVS1 stack must carry matching momcap#{cap} label [ICsprout Calibre]")
   end
 end

#=========================================================================================
# ICsprout55 layer definitions (KLayout DRC)
#
# Layer numbers per libs.tech/klayout/tech/ics55.map.  Derived layers follow the
# FreePDK45/iDRC convention: nact/pact from ACT and NP/PP implants.
# Calibre maps SRINGBLK to 354/13 and derives GRID from GRBLK OR SRINGBLK;
# the manual/stream map instead list 354/12 and GRID 179/40. Keep both pairs
# distinct; source-derived rules use the *_SRC aliases below.
#=========================================================================================

#-----------------------------------------------------------------------------------------
# Cell exclusion (real-GDS / analog-interconnect runs only)
#
# With -rd cell_exclusion=true the DRC checks run on the top-level interconnect
# and analog shapes only: the interior of every instance (bounding box shrunk by
# cell_excl_margin) is excluded from all checked input layers.  The margin band
# keeps shapes at the cell frames (interconnect crossing cell edges).
#
# The exclusion uses instance bboxes because official 191/12 is DIODE, not a
# cell frame.  Std-cell verification runs leave this OFF (the per-cell flags
# are the point there).
#-----------------------------------------------------------------------------------------

cell_interior = nil
if CELL_EXCLUSION
  ly_ex = RBA::Layout.new
  ly_ex.read($input)
  raise 'cell_exclusion requires -rd top=<topcell>' if $top.nil? || $top.empty?
  tc = ly_ex.cell($top)
  raise "cell_exclusion top cell #{$top} was not found" if tc.nil?
  interior = RBA::Region.new
  collect_bboxes = lambda do |cell, trans|
    cell.each_inst do |i|
      t = trans * i.trans
      child = ly_ex.cell(i.cell_index)
      interior += t * child.bbox
      collect_bboxes.call(child, t)
    end
  end
  collect_bboxes.call(tc, RBA::Trans.new)
  cell_interior = DRCLayer::new(self, interior).sized(-rval('cell_excl_margin').um)
end

clip_layer = lambda do |layer|
  CELL_EXCLUSION ? layer.not(cell_interior) : layer
end

# --- input layers -----------------------------------------------------------------

ACT    = clip_layer.call(input(2, 1))
NW     = clip_layer.call(input(9, 1))
LVTN   = clip_layer.call(input(17, 1))
LVTP   = clip_layer.call(input(18, 1))
HVTN   = clip_layer.call(input(21, 1))
HVTP   = clip_layer.call(input(22, 1))
TGOX   = clip_layer.call(input(28, 1))  # official 28/1 (3.3V IO gate oxide); was misaliased IOWELL
POLY   = clip_layer.call(input(41, 1))
PPO    = clip_layer.call(input(41, 4))
NP     = clip_layer.call(input(52, 1))
PP     = clip_layer.call(input(53, 1))
ESD    = clip_layer.call(input(55, 1))
SAB    = clip_layer.call(input(71, 1))  # official 71/1 (silicide block); was misaliased IOACT
DGOX   = clip_layer.call(input(27, 1))  # official 27/1 (2.5V IO gate oxide)
CTbar  = clip_layer.call(input(72, 7))  # official 72/7 contact cut-bar
CTopcblk = clip_layer.call(input(72, 5))  # official 72/5 contact OPC block
DIODE  = clip_layer.call(input(191, 12))  # official 191/12 (was misaliased BOUNDARY)
RV     = clip_layer.call(input(120, 1))  # official 120/1 redistribution via (was PADM)
CB     = clip_layer.call(input(121, 1))  # official 121/1 (was ALPAD)
RDL    = clip_layer.call(input(123, 1))  # official 123/1 redistribution layer
COVER  = clip_layer.call(input(124, 1))  # official 124/1 passivation cover
CT     = clip_layer.call(input(72, 1))
M1     = clip_layer.call(input(81, 1))
M2     = clip_layer.call(input(82, 1))
M3     = clip_layer.call(input(83, 1))
M4     = clip_layer.call(input(84, 1))
M5     = clip_layer.call(input(85, 1))
V1     = clip_layer.call(input(91, 1))
V2     = clip_layer.call(input(92, 1))
V3     = clip_layer.call(input(93, 1))
V4     = clip_layer.call(input(94, 1))
V1BAR  = clip_layer.call(input(91, 7))
V2BAR  = clip_layer.call(input(92, 7))
V3BAR  = clip_layer.call(input(93, 7))
V4BAR  = clip_layer.call(input(94, 7))
TM2    = clip_layer.call(input(103, 1))
TV2    = clip_layer.call(input(113, 1))
TV2BAR = clip_layer.call(input(113, 7))
ALPAD  = clip_layer.call(input(122, 1))  # official 122/1 aluminium pad (was 121/1)
ALPADRES = clip_layer.call(input(122, 4))
MET5RES = clip_layer.call(input(85, 4))
T4M2RES = clip_layer.call(input(103, 4))
DNW      = clip_layer.call(input(7, 1))
NW1RES   = clip_layer.call(input(9, 4))
BMIM     = clip_layer.call(input(140, 1))

ACTDUM   = clip_layer.call(input(2, 2))
ACTDUMB  = clip_layer.call(input(2, 3))
POLYDUM  = clip_layer.call(input(41, 2))
POLYDUMB = clip_layer.call(input(41, 3))
MET1DUM  = clip_layer.call(input(81, 2))
MET2DUM  = clip_layer.call(input(82, 2))
MET3DUM  = clip_layer.call(input(83, 2))
MET4DUM  = clip_layer.call(input(84, 2))
MET5DUM  = clip_layer.call(input(85, 2))
MET6DUM  = clip_layer.call(input(86, 2))
MET7DUM  = clip_layer.call(input(87, 2))
MET8DUM  = clip_layer.call(input(88, 2))
MET1DUMB = clip_layer.call(input(81, 3))
MET2DUMB = clip_layer.call(input(82, 3))
MET3DUMB = clip_layer.call(input(83, 3))
MET4DUMB = clip_layer.call(input(84, 3))
MET5DUMB = clip_layer.call(input(85, 3))
MET6DUMB = clip_layer.call(input(86, 3))
MET7DUMB = clip_layer.call(input(87, 3))
MET8DUMB = clip_layer.call(input(88, 3))
MET1SLOT = clip_layer.call(input(81, 8))
MET2SLOT = clip_layer.call(input(82, 8))
MET3SLOT = clip_layer.call(input(83, 8))
MET4SLOT = clip_layer.call(input(84, 8))
MET5SLOT = clip_layer.call(input(85, 8))
MET6SLOT = clip_layer.call(input(86, 8))
MET7SLOT = clip_layer.call(input(87, 8))
MET8SLOT = clip_layer.call(input(88, 8))
MET1MOM  = clip_layer.call(input(81, 10))
MET2MOM  = clip_layer.call(input(82, 10))
MET3MOM  = clip_layer.call(input(83, 10))
MET4MOM  = clip_layer.call(input(84, 10))
MET5MOM  = clip_layer.call(input(85, 10))
MET6MOM  = clip_layer.call(input(86, 10))
MET7MOM  = clip_layer.call(input(87, 10))
MET8MOM  = clip_layer.call(input(88, 10))
T4M2DUM  = clip_layer.call(input(103, 2))
T4M2DUMB = clip_layer.call(input(103, 3))
T4M2SLOT = clip_layer.call(input(103, 8))

INDALL   = clip_layer.call(input(302, 12))
FUTR     = clip_layer.call(input(291, 12))
FUSEALL  = clip_layer.call(input(292, 12))
EFUSEALL = clip_layer.call(input(293, 12))
POEFUSEBLK = clip_layer.call(input(294, 12))
PSUB     = clip_layer.call(input(261, 12))
LATCHUP  = clip_layer.call(input(316, 12))
MOMLVS1  = clip_layer.call(input(323, 12))
CHIPBLK  = clip_layer.call(input(351, 12))
SRBLK    = clip_layer.call(input(352, 12))
GRBLK    = clip_layer.call(input(353, 12))
SRINGBLK_SRC = clip_layer.call(input(354, 13))
SRINGBLK_MANUAL = clip_layer.call(input(354, 12))
GRID_SRC = GRBLK + SRINGBLK_SRC
GRID_MANUAL = clip_layer.call(input(179, 40))
LOGO     = clip_layer.call(input(355, 12))
DMYBLK   = clip_layer.call(input(359, 12))
NOEBBLK  = clip_layer.call(input(360, 12))
DEUPAD   = clip_layer.call(input(381, 12))
PVDD     = clip_layer.call(input(382, 12))
PVSS     = clip_layer.call(input(383, 12))
POWER_PAD = PVDD + PVSS
ESDIOT   = clip_layer.call(input(231, 12))
ESDIOE   = clip_layer.call(input(232, 12))
SRAMALL    = clip_layer.call(input(171, 12))
NODRC      = clip_layer.call(input(357, 12))

# n+/p+ active regions
NACT = ACT.and(NP)
PACT = ACT.and(PP)
NTAP = NACT.and(NW)
PTAP = PACT.not(NW)

# IO active (official: ACT under the 3.3V gate oxide TGOX)
IOACT  = ACT.and(TGOX)

# gates (poly over active) and source/drain
GATES  = POLY.and(ACT)
GATE = GATES
NGATE  = POLY.and(NACT)
PGATE  = POLY.and(PACT)
NSD    = NACT.not(NGATE)
PSD    = PACT.not(PGATE)

# all drawing layers for the off-grid check
DRAWING = ACT + NW + LVTN + LVTP + HVTN + HVTP + TGOX + DGOX + POLY + PPO + NP + PP + ESD + SAB + IOACT + CT + CTbar + CTopcblk + M1 + M2 + M3 + M4 + M5 + V1 + V2 + V3 + V4 + TM2 + TV2 + RV + CB + ALPAD + RDL + COVER + DIODE

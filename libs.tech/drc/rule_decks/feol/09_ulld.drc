#=========================================================================================
# FEOL 09 - Ultra-low-leakage device marker (ULLD)
#
# ULLD = 152/12. The source EXT/ENC edge selectors
# (LAY_POLY INSIDE EDGE AA / AA INSIDE EDGE LAY_POLY) are approximated by:
#   - gate edges: POLY edges inside AA,
#   - AA edges:   the default shielded separation to AA (only AA edges outside
#                 the marker face the marker boundary, so enclosing markers
#                 are governed by the EX enclosure checks).
# EX_3a checks the AA edge portions near the gate at 0.15 um; EX_3b checks the
# same edge family outside a 0.20 um gate halo at 0.12 um.
# ABUT/SINGULAR/OPPOSITE qualifiers are not reproduced.
#=========================================================================================

if FEOL
  ulld_width = rval('ulld_width')
  ULLD.drc(width < ulld_width.um).not_inside(NODRC).output('ULLD_W_1',
    "ULLD_W_1: ULLD width must be at least #{ulld_width} um outside NODRC [Calibre source]")

  ulld_space = rval('ulld_space')
  ULLD.drc(space < ulld_space.um).not_inside(NODRC).output('ULLD_S_1',
    "ULLD_S_1: ULLD spacing must be at least #{ulld_space} um outside NODRC [Calibre source]")

  ulld_aa_space = rval('ulld_aa_space')
  ULLD.drc(separation(ACT) < ulld_aa_space.um).not_inside(NODRC).output('ULLD_S_2',
    "ULLD_S_2: ULLD to AA spacing must be at least #{ulld_aa_space} um outside NODRC [Calibre source]")

  ulld_nact_space = rval('ulld_nact_space')
  ULLD.drc(separation(NACT) < ulld_nact_space.um).not_inside(NODRC).output('ULLD_S_4',
    "ULLD_S_4: ULLD to N+ AA spacing must be at least #{ulld_nact_space} um outside NODRC [Calibre source]")

  gate_sd_edges = POLY.edges.inside_part(ACT)
  ulld_gate_space = rval('ulld_gate_space')
  ULLD.edges.separation(gate_sd_edges, ulld_gate_space.um).polygons
    .not_inside(NODRC).output('ULLD_S_5',
      "ULLD_S_5: ULLD to gate spacing along the source/drain direction must be at least #{ulld_gate_space} um outside NODRC [Calibre source]")

  ulld_aa_gate_space = rval('ulld_aa_gate_space')
  ULLD.drc(separation(ACT) < ulld_aa_gate_space.um).not_inside(NODRC).output('ULLD_S_6',
    "ULLD_S_6: ULLD to AA spacing along the poly direction must be at least #{ulld_aa_gate_space} um outside NODRC [Calibre source]")

  ulld_aa_ext = rval('ulld_aa_ext')
  ACT.edges.inside_part(ULLD).extended_out(ulld_aa_ext.um).not(ULLD)
    .not_inside(NODRC).output('ULLD_EX_1',
      "ULLD_EX_1: ULLD extension outside AA must be at least #{ulld_aa_ext} um outside NODRC [Calibre source]")

  ulld_gate_ext = rval('ulld_gate_ext')
  gate_sd_in_ulld = POLY.edges.inside_part(ACT.and(ULLD))
  gate_sd_in_ulld.extended_out(ulld_gate_ext.um).not(ULLD)
    .not_inside(NODRC).output('ULLD_EX_2',
      "ULLD_EX_2: ULLD extension outside GATE along the source/drain direction must be at least #{ulld_gate_ext} um outside NODRC [Calibre source]")

  ulld_aa_gate_ext = rval('ulld_aa_gate_ext')
  ACT.edges.inside_part(ULLD).and(GATE.edges).extended_out(ulld_aa_gate_ext.um).not(ULLD)
    .not_inside(NODRC).output('ULLD_EX_3a',
      "ULLD_EX_3a: ULLD extension outside AA along the poly direction must be at least #{ulld_aa_gate_ext} um outside NODRC [Calibre source]")

  # ULLD_EX_3b: the far-poly branch of the same AA-edge family, beyond the
  # 0.20 um gate-edge extension built by the source. The Calibre X2/X3/X4 edge
  # constructs are approximated with the AA long edges that pass under the
  # gate, clipped outside a 0.20 um gate halo. Only edges inside the ULLD
  # marker are measured, matching Calibre ENC (no marker region => no check).
  ulld_aa_far_ext = rval('ulld_aa_far_ext')
  aa_under_gate_edges = ACT.edges.inside_part(POLY)
  aa_long_edges = ACT.edges.interacting(aa_under_gate_edges)
  gate_far_halo = GATE.sized(0.20.um, 0).or(GATE.sized(0, 0.20.um))
  aa_far_edges = aa_long_edges.outside_part(gate_far_halo).inside_part(ULLD)
  aa_far_edges.extended_out(ulld_aa_far_ext.um).not(ULLD)
    .not_inside(NODRC).output('ULLD_EX_3b',
      "ULLD_EX_3b: ULLD extension outside AA along the poly direction must be at least #{ulld_aa_far_ext} um when the related poly is farther than 0.20 um, outside NODRC [Calibre source]")

  ulld_area = rval('ulld_area')
  ULLD.not(ULLD.with_area(ulld_area.um2, 1e9.um2)).not_inside(NODRC).output('ULLD_A_1',
    "ULLD_A_1: ULLD area must be at least #{ulld_area} um^2 outside NODRC [Calibre source]")
  ulld_hole_area = rval('ulld_hole_area')
  ULLD.holes.not(ULLD.holes.with_area(ulld_hole_area.um2, 1e9.um2)).not_inside(NODRC).output('ULLD_A_2',
    "ULLD_A_2: ULLD enclosed hole area must be at least #{ulld_hole_area} um^2 outside NODRC [Calibre source]")

  ULLD.and(PSUB).not_inside(NODRC).output('ULLD_R_1',
    'ULLD_R_1: ULLD must not overlap PSUB outside NODRC [Calibre source]')
  ULLD.and(DG).not_inside(NODRC).output('ULLD_R_1',
    'ULLD_R_1: ULLD must not overlap DG outside NODRC [Calibre source]')
  ULLD.and(TG).not_inside(NODRC).output('ULLD_R_1',
    'ULLD_R_1: ULLD must not overlap TG outside NODRC [Calibre source]')

  ULLD.not_interacting(HVTN).not_inside(NODRC).output('ULLD_R_2',
    'ULLD_R_2: ULLD must interact NVT3 outside NODRC [Calibre source]')
  ULLD.not_interacting(HVTP).not_inside(NODRC).output('ULLD_R_2',
    'ULLD_R_2: ULLD must interact PVT3 outside NODRC [Calibre source]')
end

#=========================================================================================
# FEOL 05 - Contact (CT)
#
# Port CT_EN_1 directly from the source coverage expression.  Tech-LEF cut
# dimensions are routing constraints, not substitutes for the Calibre CT rules.
#=========================================================================================

if FEOL
  CT.not(M1.and(POLY.or(ACT))).not_inside(SRAMALL).not_inside(NODRC).output('cont.ct.inside',
    "CT_EN_1: CT must be covered by M1 and (POLY or ACT); waived inside SRAMALL and NODRC")

  # Unsupported source rules: CT_W_1, CT_W_2, CT_S_1, CT_S_1a, CT_S_2,
  # CT_S_3 through CT_S_6, CT_EN_2a, CT_EN_2b, CT_EN_3a_3b_3c,
  # CT_EN_4a_4b_4c, CT_EN_4d, CT_R_1 through CT_R_3, CT_R_5.
  # These require fixed-shape/CTbar treatment, connectivity, directional
  # enclosure, or source-only exclusion layers. Recommended CT_S_4_R,
  # CT_EN_2_R, CT_EN_3_R, CT_EN_4a_R_4b_R remain disabled by default.
end

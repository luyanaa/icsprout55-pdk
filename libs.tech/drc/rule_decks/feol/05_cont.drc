#=========================================================================================
# FEOL 05 - Contact (CT)
#
# CT_EN_1 uses the official CT alias, CT = CTi OR CTbar (Calibre source
# lines 865-866, 3965-3967). Tech-LEF cut dimensions are not substitutes for
# the Calibre CT width rules.
#=========================================================================================

if FEOL
  cts = CT.or(CTbar)
  cts.not(M1.and(POLY.or(ACT))).not_inside(SRAMALL).not_inside(NODRC).output('cont.ct.inside',
    "CT_EN_1: CT/CTbar must be covered by M1 and (POLY or ACT); waived inside SRAMALL and NODRC [Calibre source]")

  # CT_EN_2a requires its source threshold for CTs that interact ACT.
  ct_min_active_enclosure = rval('ct_drc_enc_act')
  ct_active = cts.interacting(ACT)
  ct_active.drc(enclosed(ACT) < ct_min_active_enclosure.um).not_inside(SRAMALL).not_inside(NODRC).output('cont.ct.active.enclosure',
    "CT_EN_2a: CT/CTbar active enclosure must be at least #{ct_min_active_enclosure} um [Calibre source]")

  # CT_W_1 is omitted: source lines 3895-3902 use RCT/GCT geometry and
  # region-specific rectangular checks not represented by existing DRC layers.
  # The KLayout CT_EN_2a enclosure operator preserves the 0.015um threshold,
  # but not Calibre's ABUT<90/SINGULAR/OUTSIDE ALSO qualifiers.
  # CT_W_2, CT_S_1 through CT_S_6, CT_EN_2b through CT_EN_4d, and CT_R_1
  # through CT_R_5 remain omitted because they need connectivity, directional
  # enclosure, or source-only exclusion semantics.
end

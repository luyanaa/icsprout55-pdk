#=========================================================================================
# FEOL 05 - Contact (CT)
#
# Port of iDRC cut-layer checks.  CT values are exact tech-LEF values
# (WIDTH 0.09, SPACING 0.11, ENCLOSURE ABOVE 0.04); separation/enclosure to
# POLY/ACT are measured (provenance: gds).
#=========================================================================================

if TABLES.include?('feol') || FEOL
  #--- CT: minimum width / spacing (LEF) ----------------------------------------------
  CT.width(rval('ct_width').um, euclidian).output('cont.ct.width',
    "cont.ct.width: CT min width #{rval('ct_width')} um [lef]")
  CT.space(rval('ct_space').um, euclidian).output('cont.ct.space',
    "cont.ct.space: CT min spacing #{rval('ct_space')} um [lef]")

  #--- CT enclosure by M1 / POLY / ACT (LEF ENCLOSURE ABOVE 0.04) ---------------------
  # DISABLED 2026-09-25 (user call): the LEF ENCLOSURE ABOVE 0.04 flags every
  # released std cell (cells draw a uniform 0.025 um CT-to-M1 top enclosure); the
  # official Calibre deck has no plain CT-to-M1 enclosure rule (only the seal-ring
  # CT bar SRCK_14a_CT 0.375).  Value stays in ics55_rules.json as the LEF router
  # constraint.  Re-enable by uncommenting.
  # M1.enclosing(CT, rval('ct_enc_m1').um).output('cont.ct.enc.m1',
  #   "cont.ct.enc.m1: CT enclosure by M1 #{rval('ct_enc_m1')} um [lef]")
  POLY.enclosing(CT, rval('ct_enc_poly').um).output('cont.ct.enc.poly',
    "cont.ct.enc.poly: CT enclosure by POLY #{rval('ct_enc_poly')} um [lef]")
  ACT.enclosing(CT, rval('ct_enc_act').um).output('cont.ct.enc.act',
    "cont.ct.enc.act: CT enclosure by ACT #{rval('ct_enc_act')} um [lef]")

  #--- CT must be inside POLY, ACT or M1 (foundry "contact on poly/active/metal") -----
  CT.not(POLY.or(ACT).or(M1)).output('cont.ct.inside',
    "cont.ct.inside: CT must be inside POLY, ACT or M1 [derived]")
end

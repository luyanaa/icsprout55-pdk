#=========================================================================================
# FEOL 02 - Active
#
# Port only source geometry representable without changing Calibre qualifiers.
# ACT_A_1 is an area test with exact SRAMALL/NODRC waivers.  Width, spacing,
# directional enclosure, and topology rules need Calibre-specific operators.
#=========================================================================================

if FEOL
  ACT.not(ACT.with_area(0.0384.um2, 1e9.um2)).not_inside(SRAMALL).not_inside(NODRC).output('active.act.area',
    "ACT_A_1: AA minimum area 0.0384 um^2; waived inside SRAMALL and NODRC")

  # Unsupported source rules: ACT_W_1, ACT_W_2, ACT_W_3a, ACT_W_3b,
  # ACT_L_1, ACT_L_2, ACT_S_1, ACT_S_1a, ACT_S_2, ACT_S_3, ACT_S_4,
  # ACT_S_5 through ACT_S_8, ACT_EN_1, ACT_EN_2, ACT_EN_2a, ACT_A_2,
  # ACT_R_1, ACT_R_3.  Recommended ACT_S_1_R / ACT_S_2a_R and ACT_W_3a_R
  # remain disabled (OPEN_RECOMMENDED_ON=NO).
  # ACT_D_* require density windows/gradient support; not implemented here.
end

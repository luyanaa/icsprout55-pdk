#=========================================================================================
# FEOL 03 - Poly
#
# Port source area checks that map directly to KLayout regions.  Rules whose
# Calibre definition depends on edge classes, connectivity, density windows,
# or directional enclosure remain disabled instead of using geometric proxies.
#=========================================================================================

if FEOL
  POLY.not(POLY.with_area(0.04.um2, 1e9.um2)).not_inside(SRAMALL).not_inside(NODRC).output('poly.poly.area',
    "PO_A_1: POLY minimum area 0.04 um^2; waived inside SRAMALL and NODRC")
  POLY.holes.not(POLY.holes.with_area(0.09.um2, 1e9.um2)).not_inside(NODRC).output('poly.poly.enclosed_area',
    "PO_A_2: POLY enclosed area minimum 0.09 um^2; waived inside NODRC")

  # Unsupported source rules: PO_W_1, PO_W_2a through PO_W_2f, PO_W_3,
  # PO_S_1 through PO_S_3, PO_S_5 through PO_S_7, PO_S_9, PO_S_11,
  # PO_S_12, PO_S_14, PO_S_15, PO_S_16, PO_EX_1, PO_EX_2, PO_L_1,
  # PO_R_1, PO_R_2.  PO_S_4_R, PO_S_7a_R, PO_S_8_R, PO_S_13_R,
  # PO_S_14a_R, PO_EN_1_R through PO_EN_3_R, PO_EX_1_R, PO_EX_3_R,
  # PO_L_2_R, and PO_A_1_R remain disabled (OPEN_RECOMMENDED_ON=NO).
  # PO_D_* are disabled because density-window/gradient operators are absent.
end

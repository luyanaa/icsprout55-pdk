#=========================================================================================
# BEOL 07 - Vias (V1..V4, T4V2)
#
# Only exact source geometry predicates and their source waivers are emitted.
# Qualifier, width-metric, and array checks without direct KLayout equivalents
# are intentionally omitted.
#=========================================================================================

if BEOL
  square_exclusions = GRID_SRC.or(SRINGBLK_SRC).or(NODRC)

  [
    ['V1', V1, 'v1', M1.not(MET1SLOT)],
    ['V2', V2, 'v2', M2.not(MET2SLOT)],
    ['V3', V3, 'v3', M3.not(MET3SLOT)],
    ['V4', V4, 'v4', M4.not(MET4SLOT)]
  ].each do |name, via, key, lower_metal|
    source_via = via

    # VIAn_W_1 checks exact square geometry and waives the union of GRID,
    # SRINGBLK, and NODRC.
    square_size = rval("#{key}_width")
    rectangles = source_via.rectangles
    wrong_rectangles = rectangles.without_bbox_width(square_size.um)
      .or(rectangles.without_bbox_height(square_size.um))
    non_squares = source_via.non_rectangles.or(wrong_rectangles)
    non_squares.not_inside(square_exclusions).output("via.#{key}.width",
      "#{name}_W_1: #{name} must be a #{square_size}x#{square_size} um square outside GRID/SRINGBLK/NODRC [Calibre source]")

    # VIAn_R_5 selects via polygons containing a 45-degree edge; exclusions
    # are applied in the same order as the source rule.
    rotated = source_via.interacting(source_via.edges.with_angle(45, absolute))
    rotated.not_inside(SRINGBLK_SRC).not_inside(NODRC).output("via.#{key}.rotated",
      "#{name}_R_5: 45-degree #{name} edges are not allowed outside SRINGBLK/NODRC [Calibre source]")

    # The separate OUTLAYER in VIAn_EN_2a_2b_2c flags via geometry outside
    # its lower metal; this clause has only the NODRC waiver.
    source_via.not(lower_metal).not_inside(NODRC).output("via.#{key}.cover.lower",
      "#{name}_EN_2a_2b_2c: #{name} must be covered by its lower metal outside NODRC [Calibre source]")
  end

  tv2_source = TV2.or(TV2BAR)
  rotated_tv2 = tv2_source.interacting(tv2_source.edges.with_angle(45, absolute))
  rotated_tv2.not_inside(SRINGBLK_SRC).not_inside(NODRC).output('via.tv2.rotated',
    'T4V2_R_3: 45-degree T4V2 edges are not allowed outside SRINGBLK/NODRC [Calibre source]')

  # For total_metal=6/top_metal=1, T4V2_EN_2_EN_3 selects M5 as its
  # bottom metal. This separate OUTLAYER has only the NODRC waiver.
  tv2_source.not(M5.not(MET5SLOT)).not_inside(NODRC).output('via.tv2.cover.lower',
    'T4V2_EN_2_EN_3: T4V2 must be covered by M5 outside NODRC [Calibre source]')

  # Omitted active rules: V1-V4_W_2 (WITH WIDTH bar predicates), V1-V4_S_1
  # through _S_3 (ABUT/SINGULAR, array-neighbor, OPPOSITE/NOT CONNECTED),
  # the directional GOOD enclosure clauses in V1-V4_EN_2a_2b_2c and
  # V1-V4_EN_5a_5b, and V1-V4_R_3 (H-shaped metal arrays); T4V2_W_1/_W_2,
  # T4V2_S_1, the directional GOOD clause in T4V2_EN_2_EN_3, and
  # T4V2_EN_5_EN_6. T4V2_W_1 also uses Calibre's GT4V2 rule-result group.
  # Recommended rules are inactive for OPEN_RECOMMENDED_ON=NO.
end
